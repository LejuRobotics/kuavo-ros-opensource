# Radians, in knee / leg / waist_pitch / waist_yaw order.
# SET_TARGET is a one-shot transaction. QUERY does not renew motion permission.
uint8 QUERY=0
uint8 SET_TARGET=1
uint8 CANCEL=2
uint8 command
uint64 request_id
float64[4] position
---
uint8 IDLE=0
uint8 QUEUED=1
uint8 MOVING=2
uint8 SETTLED=3
uint8 BRAKING=4
uint8 ABORTED=5
bool accepted
uint64 request_id
uint8 state
bool ready
string message
float64[4] position
float64[4] measured_position
float64[4] target_position
float64[4] lower
float64[4] upper
