<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="require_ik_hard_isolation" default="$(optenv KUAVO_REQUIRE_IK_HARD_ISOLATION false)" />
  <arg name="arm_driver_reserved_cpus" default="$(optenv KUAVO_ARM_DRIVER_RESERVED_CPUS 7)" />
  <arg name="reference_transport" default="shm" />
  <arg name="reference_shm_key" default="344421" />
  <arg name="owner_shm_key" default="344422" />
  <arg name="controller_type" default="legacy" />
  <arg name="real" default="true" />
  <arg name="robot_version" default="$(eval optenv('ROBOT_VERSION', 'UNCONFIGURED_ROBOT_VERSION' if arg('controller_type') == 'wheel_arm_abs_vel' else '40'))" />
  <arg name="dynamics_backend" default="$(eval 'rnea' if arg('real') else 'wbc')" />
  <group if="$(eval arg('controller_type') == 'wheel_arm_abs_vel')">
  <env name="KUAVO_REQUIRE_IK_HARD_ISOLATION" value="$(arg require_ik_hard_isolation)" />
  <env name="KUAVO_ARM_DRIVER_RESERVED_CPUS" value="$(arg arm_driver_reserved_cpus)" />
    <group if="$(arg real)">
      <include file="$(find wheel_arm_abs_vel)/launch/load_kuavo_real_velocity_ik.launch">
        <arg name="require_ik_hard_isolation" value="$(arg require_ik_hard_isolation)" />
        <arg name="arm_driver_reserved_cpus" value="$(arg arm_driver_reserved_cpus)" />
        <arg name="robot_version" value="$(arg robot_version)" />
        <arg name="dynamics_backend" value="$(arg dynamics_backend)" />
        <arg name="reference_transport" value="$(arg reference_transport)" />
        <arg name="reference_shm_key" value="$(arg reference_shm_key)" />
        <arg name="owner_shm_key" value="$(arg owner_shm_key)" />
      </include>
    </group>
    <group unless="$(arg real)">
      <include file="$(find wheel_arm_abs_vel)/launch/load_kuavo_mujoco_velocity_ik.launch">
        <arg name="require_ik_hard_isolation" value="$(arg require_ik_hard_isolation)" />
        <arg name="arm_driver_reserved_cpus" value="$(arg arm_driver_reserved_cpus)" />
        <arg name="robot_version" value="$(arg robot_version)" />
        <arg name="dynamics_backend" value="$(arg dynamics_backend)" />
        <arg name="reference_transport" value="$(arg reference_transport)" />
        <arg name="reference_shm_key" value="$(arg reference_shm_key)" />
        <arg name="owner_shm_key" value="$(arg owner_shm_key)" />
      </include>
    </group>
  </group>
  <group unless="$(eval arg('controller_type') == 'wheel_arm_abs_vel')">
    <group if="$(arg real)">
      <include file="$(find humanoid_controllers)/launch/load_kuavo_real_wheel.launch">
        <arg name="robot_version" value="$(arg robot_version)" />
      </include>
    </group>
    <group unless="$(arg real)">
      <include file="$(find humanoid_controllers)/launch/load_kuavo_mujoco_sim_wheel.launch">
        <arg name="robot_version" value="$(arg robot_version)" />
      </include>
    </group>
  </group>
</launch>
