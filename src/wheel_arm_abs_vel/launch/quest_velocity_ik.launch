<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="filter_tuning_enabled" default="$(optenv KUAVO_ABS_FILTER_TUNING true)" />
  <arg name="require_ik_hard_isolation" default="$(optenv KUAVO_REQUIRE_IK_HARD_ISOLATION false)" />
  <arg name="arm_driver_reserved_cpus" default="$(optenv KUAVO_ARM_DRIVER_RESERVED_CPUS 7)" />
  <env name="KUAVO_REQUIRE_IK_HARD_ISOLATION" value="$(arg require_ik_hard_isolation)" />
  <env name="KUAVO_ARM_DRIVER_RESERVED_CPUS" value="$(arg arm_driver_reserved_cpus)" />
  <arg name="j3_overshoot_profile" default="true" />
  <arg name="j3_kd" default="18.0" />
  <arg name="communication_full_rate_audit" default="false" />
  <arg name="communication_second_round_enabled" default="true" />
  <!-- Compatibility for the old Pico shortcut; the standard Quest entry is unchanged. -->
  <arg name="legacy_pico_profile" default="false" />
  <!-- Transport only; shared memory is the default. -->
  <arg name="reference_transport" default="shm" />
  <arg name="reference_shm_key" default="344421" />
  <arg name="owner_shm_key" default="344422" />
  <param name="/whole_body_velocity_ik/reference/transport" value="$(arg reference_transport)" />
  <param name="/whole_body_velocity_ik/reference/shm_reference_key" value="$(arg reference_shm_key)" />
  <param name="/whole_body_velocity_ik/reference/shm_owner_key" value="$(arg owner_shm_key)" />
  <arg name="robot_version" default="$(optenv ROBOT_VERSION UNCONFIGURED_ROBOT_VERSION)" />
  <!-- Pico adapts to Quest input semantics; keep legacy use_pico=false. -->
  <arg name="input_source" default="quest" />
  <arg name="hold_on_input_timeout" default="true" />
  <arg name="pico_port" default="12345" />
  <arg name="pico_peer_ip" default="" />
  <arg name="pico_advertise_ip" default="" />
  <arg name="pico_broadcast_ip" default="" />
  <arg name="pico_calibration_file" default="$(find wheel_arm_abs_vel)/config/pico_quest_input.yaml" />
  <param name="/vr_input_source" value="$(eval {'quest': 'quest', 'pico': 'pico'}[arg('input_source')])" />
  <arg name="execution_governor_enabled" default="true" />
  <arg name="wrist_envelope_enabled" default="$(arg filter_tuning_enabled)" />
  <arg name="vr_kalman_flattening_enabled" default="false" />
  <arg name="vr_kalman_enabled" default="true" />
  <arg name="continuous_reference_enabled" default="true" />
  <arg name="hand_reference_frequency" default="12.0" />
  <arg name="orientation_reference_mode" default="fixed_bandwidth" />
  <arg name="hand_position_cutoff_hz" default="10.0" />
  <arg name="hand_orientation_cutoff_hz" default="8.0" />
  <arg name="joint_jerk_enabled" default="true" />
  <arg name="adaptive_reference_enabled" default="true" />
  <arg name="innovation_reference_enabled" default="true" />
  <arg name="torso_reference_frequency" default="2.5" />
  <!-- Validated real-robot defaults; explicit arguments remain available for comparison. -->
  <arg name="operating_temporal_config" default="$(find wheel_arm_abs_vel)/config/operating_temporal_experiment.yaml" />
  <arg name="operating_envelope_enabled" default="true" />
  <arg name="temporal_cost_enabled" default="true" />
  <arg name="operating_diagnostics_enabled" default="true" />
  <arg name="velocity_tcp_geometry_file" default="" />
  <arg name="enable_vr_ik_debug" default="false" />
  <arg name="wheel_ik" default="true" />
  <arg name="enable_ik_velocity_limit" default="false" />
  <arg name="enable_velocity_ik_takeover" default="true" />
  <arg name="whole_body_shadow_isolate_position_ik" default="false" />
  <arg name="enable_position_ik_status_log" default="false" />
  <arg name="velocity_ik_feasibility_mode" default="active" />
  <arg name="velocity_ik_nominal_arm_reach" default="0.70937088" />
  <arg name="velocity_ik_selected_reach_reserve" default="0.03" />
  <arg name="velocity_ik_joint_safe_range_ratios" default="[0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.8]" />
  <arg name="velocity_ik_joint_safe_center" default="[0.2617993878, 0.0, 0.0, -0.5235987756, 0.0, 0.0, 0.0, 0.2617993878, 0.0, 0.0, -0.5235987756, 0.0, 0.0, 0.0]" />
  <arg name="tracking_source_mode" default="controller" />
  <arg name="publish_tracking_mapping_debug" default="$(arg enable_vr_ik_debug)" />
  <arg name="record_task07_debug_bag" default="false" />
  <arg name="task07_debug_bag_dir" default="$(env HOME)/.ros/task07" />
  <group if="$(arg enable_vr_ik_debug)">
    <param name="/vr_ik/enable_solve_loop_timing_log" value="true" />
    <param name="/vr_ik/enable_lock_wait_timing_log" value="true" />
    <param name="/vr_ik/enable_arm_traj_receive_timing_log" value="true" />
    <param name="/vr_ik/enable_arm_traj_shadow_publish" value="true" />
    <param name="/vr_ik/enable_ik_velocity_limit_shadow_publish" value="true" />
  </group>
  <node pkg="wheel_arm_abs_vel" type="record_task07_absolute_bag.py" name="task07_absolute_debug_recorder" args="--output-dir $(arg task07_debug_bag_dir)" output="screen" if="$(arg record_task07_debug_bag)" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <arg name="version" default="4" />
  <arg name="ctrl_arm_idx" default="2" />
  <arg name="ik_type_idx" default="0" />
  <arg name="ip_address" default="" />
  <arg name="control_torso" default="true" />
  <arg name="dexhand_front_trigger" default="true" doc="Both front triggers independently command six dexhand channels, 0=open and 100=closed." />
  <arg name="control_finger_type" default="0" />
  <arg name="predict_gesture" default="false" />
  <arg name="ee_type" default="auto" doc="Read EndEffectorType from this robot version kuavo.json; optional explicit override" />
  <arg name="sg100_enabled" default="true" doc="Allow the shared end-effector resolver to start SG100 only for heiman; false explicitly disables it" />
  <node pkg="wheel_arm_abs_vel" type="absolute_end_effector.py" name="sg100_mapper_bridge" args="--bridge --config &quot;$(find kuavo_assets)/config/kuavo_v$(arg robot_version)/kuavo.json&quot; --ee-type=$(arg ee_type)" if="$(arg sg100_enabled)" output="screen" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <!-- 头部指令由机器端 head_control_node 发布。 -->
  <arg name="enable_head_control" default="false" />
  <arg name="enable_terminal_start" default="false" />
  <!-- Input-terminal alternative to long A; controller-terminal keyboard remains unchanged. -->
  <node pkg="wheel_arm_abs_vel" type="terminal_initial_start.py" name="absolute_terminal_start"
        output="screen" if="$(arg enable_terminal_start)"
        launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <arg name="hand_reference_mode" default="thumb_index" />
  <arg name="use_arm_collision" default="false" />
  <arg name="use_two_stage_ik" default="false" />
  <arg name="use_step_turning" default="false" />
  <arg name="use_cpp_monitor" default="false" />
  <arg name="use_cpp_incremental_ik" default="false" />
  <param name="/use_cpp_incremental_ik" value="$(arg use_cpp_incremental_ik)" type="bool" />
  <arg name="enable_vr_stop_robot" default="true" />
  <param name="/enable_vr_stop_robot" value="$(arg enable_vr_stop_robot)" type="bool" />
  <arg name="enable_absolute_target_alignment" default="$(arg wheel_ik)" />
  <param name="/vr_ik/enable_absolute_mode_handshake" value="$(eval arg('enable_absolute_target_alignment') and not arg('use_cpp_incremental_ik'))" type="bool" />
  <arg name="enable_absolute_start_gap_check" default="false" />
  <arg name="absolute_enable_max_position_error" default="0.30" />
  <arg name="absolute_enable_max_orientation_error" default="0.35" />
  <arg name="absolute_enable_max_vr_age" default="0.25" />
  <arg name="absolute_enable_max_joint_state_age" default="0.10" />
  <arg name="absolute_enable_mode_timeout" default="3.0" />
  <arg name="absolute_enable_service_timeout" default="2.0" />
  <arg name="absolute_enable_exit_mode" default="0" />
  <arg name="enable_absolute_discontinuity_guard" default="true" />
  <arg name="absolute_max_tcp_position_step" default="0.15" />
  <arg name="absolute_max_tcp_orientation_step" default="1.0472" />
  <arg name="absolute_max_joint_step" default="0.25" />
  <arg name="absolute_ik_trust_region_step" default="0.25" />
  <arg name="absolute_hard_recovery_successes" default="3" />
  <arg name="absolute_hard_target_max_step" default="0.25" />
  <arg name="absolute_hard_recovery_max_offset" default="0.25" />
  <arg name="absolute_hard_recovery_stability_step" default="0.05" />
  <arg name="absolute_execution_max_joint_velocity" default="1.5" />
  <arg name="absolute_execution_max_joint_acceleration" default="6.0" />
  <arg name="absolute_execution_min_joint_limit_margin" default="0.03" />
  <arg name="tracking_rearm_stable_frames" default="3" />
  <group if="$(eval int(arg('robot_version')) == 61 or int(arg('robot_version')) == 62 or int(arg('robot_version')) == 63 or int(arg('robot_version')) == 400062)">
    <param name="/vr_cmd_vel/linear_scale_x" value="0.4" />
    <param name="/vr_cmd_vel/linear_scale_y" value="0.4" />
    <param name="/vr_cmd_vel/angular_scale_z" value="0.45" />
  </group>
  <arg name="single_hand_mode" default="false" />
  <arg name="use_arm_only_ik" default="false" />
  <param name="/single_hand_mode" value="$(arg single_hand_mode)" type="bool" />
  <arg name="init_control_waist_enable" default="true" />
  <arg name="enable_timestamp_log" default="false" />
  <param name="/enable_timestamp_log" value="$(arg enable_timestamp_log)" type="bool" />
  <arg name="use_pico" default="false" />
  <arg name="enable_videostream" default="false" />
  <arg name="camera_publisher_name" default="/camera/color" />
  <arg name="task_space_acc_limit" default="500.0" />
  <arg name="task_space_jerk_limit" default="3000.0" />
  <arg name="joint_space_acc_limit" default="500.0" />
  <arg name="joint_space_jerk_limit" default="3000.0" />
  <arg name="max_joint_velocity" default="30.0" />
  <arg name="delta_scale_x" default="1.26" />
  <arg name="delta_scale_y" default="1.26" />
  <arg name="delta_scale_z" default="1.26" />
  <arg name="delta_scale_roll" default="1.0" />
  <arg name="delta_scale_pitch" default="1.0" />
  <arg name="delta_scale_yaw" default="1.0" />
  <arg name="max_pos_diff" default="0.45" />
  <arg name="arm_move_threshold" default="0.002" />
  <arg name="reset_joint_to_default" default="true" />
  <arg name="pos_vel_limit" default="30.0" />
  <arg name="fhan_r" default="3000.0" />
  <arg name="fhan_kh0" default="3.0" />
  <arg name="fhan_r_joint" default="6000.0" />
  <arg name="fhan_kh0_joint" default="3.0" />
  <arg name="ik_ros_fhan_r" default="3000.0" />
  <arg name="ik_ros_fhan_kh0" default="4.0" />
  <arg name="ik_ros_fhan_r_joint" default="3000.0" />
  <arg name="ik_ros_fhan_kh0_joint" default="4.0" />
  <arg name="ik_ros_max_joint_velocity" default="300.0" />
  <arg name="left_hand_quat_offset_roll" default="0.0" />
  <arg name="left_hand_quat_offset_pitch" default="0.0" />
  <arg name="left_hand_quat_offset_yaw" default="0.0" />
  <arg name="right_hand_quat_offset_roll" default="0.0" />
  <arg name="right_hand_quat_offset_pitch" default="0.0" />
  <arg name="right_hand_quat_offset_yaw" default="0.0" />
  <arg name="sphere_radius_limit" default="0.6" />
  <arg name="min_reachable_distance" default="0.08" />
  <arg name="elbow_min_distance" default="0.16" />
  <arg name="elbow_max_distance" default="0.24" />
  <arg name="use_incremental_hand_orientation" default="false" />
  <arg name="limit_shoulder_pitch_upper" default="false" />
  <arg name="shoulder_pitch_upper_limit" default="0.3" />
  <param name="/quest3/limit_shoulder_pitch_upper" value="$(arg limit_shoulder_pitch_upper)" type="bool" />
  <param name="/quest3/shoulder_pitch_upper_limit" value="$(arg shoulder_pitch_upper_limit)" type="double" />
  <arg name="box_min_bound" default="[0.00, -0.6, -0.19]" />
  <arg name="box_max_bound" default="[0.4, 0.6, 0.4]" />
  <arg name="chest_offset_y_ax" default="0.05" />
  <arg name="left_center" default="[0, 0.02, 0]" />
  <arg name="right_center" default="[0, -0.02, 0]" />
  <arg name="default_left_hand_pos_on_exit" default="[0.00, 0.293, -0.16]" />
  <arg name="default_right_hand_pos_on_exit" default="[0.00, -0.293, -0.16]" />
  <arg name="hand_changing_mode_threshold" default="1.20" />
  <arg name="zyx_limits_final" default="[1.4923, 1.4923, 1.4923]" />
  <arg name="zyx_limits_ee" default="[1.4923, 1.4923, 1.4923]" />
  <arg name="zyx_limits_link4" default="[1.5708, 0.6, 0.6]" />
  <param name="/quest3/use_step_turning" value="$(arg use_step_turning)" />
  <param name="control_torso" value="$(arg control_torso)" type="bool" />
  <param name="/wheel_ik" value="$(arg wheel_ik)" type="bool" />
  <param name="/vr_ik/enable_velocity_ik_takeover" value="$(arg enable_velocity_ik_takeover)" type="bool" />
  <param name="/reset_joint_to_default" value="$(arg reset_joint_to_default)" type="bool" />
  <param name="/use_pico" value="$(arg use_pico)" type="bool" />
  <node pkg="wheel_arm_abs_vel" type="pinocchio_velocity_ik_node" name="absolute_velocity_ik" output="screen" if="$(eval arg('enable_velocity_ik_takeover') and arg('wheel_ik') and not arg('use_cpp_incremental_ik'))" respawn="false" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh ik')" required="true">
    <param name="continuity/hold_on_timeout" value="$(arg hold_on_input_timeout)" type="bool" />
    <param name="robot_version" value="$(arg robot_version)" type="int" />
    <param name="ctrl_arm_idx" value="$(arg ctrl_arm_idx)" type="int" />
    <param name="solver_rate_hz" value="500.0" type="double" />
    <param name="target_topic" value="/mm/teleop_tcp_target" type="string" />
    <param name="enable_takeover" value="$(arg enable_velocity_ik_takeover)" type="bool" />
    <param name="output_prefix" value="/whole_body_velocity_ik/diagnostics" type="string" />
    <param name="formal_reference_topic" value="/whole_body_velocity_ik/reference" type="string" />
    <param name="command_topic" value="/kuavo_arm_traj" type="string" />
    <param name="command_frame_id" value="absolute_velocity_ik_v1" type="string" />
    <param name="require_external_arm_mode" value="$(arg enable_velocity_ik_takeover)" type="bool" />
    <param name="strict_target_frame" value="true" type="bool" />
    <param name="tracking_source_mode" value="$(arg tracking_source_mode)" type="string" />
    <param name="publish_input_debug" value="$(arg enable_vr_ik_debug)" type="bool" />
    <param name="feasibility_mode" value="$(arg velocity_ik_feasibility_mode)" type="string" />
    <param name="enable_singularity_escape_constraints" value="false" type="bool" />
    <param name="root_translation_deadband" value="0.035" type="double" />
    <param name="root_translation_full_distance" value="0.10" type="double" />
    <param name="root_translation_coherence_start" value="0.03" type="double" />
    <param name="root_translation_coherence_full" value="0.12" type="double" />
    <param name="root_translation_active_confidence" value="0.20" type="double" />
    <param name="root_translation_release_error" value="0.01" type="double" />
    <param name="base_intent_gain" value="2.0" type="double" />
    <param name="base_intent_weight" value="5.0" type="double" />
    <param name="body_torso_deadband" value="0.015" type="double" />
    <param name="body_torso_full_error" value="0.15" type="double" />
    <param name="cascade_stage_dwell_time" value="0.10" type="double" />
    <param name="cascade_stage_admission_threshold" value="0.15" type="double" />
    <param name="cascade_stage_release_dwell_time" value="0.60" type="double" />
    <param name="cascade_stage_release_threshold" value="0.05" type="double" />
    <param name="natural_hang_arm_threshold" value="0.08" type="double" />
    <param name="cascade_minimum_active_recruitment" value="0.20" type="double" />
    <rosparam param="lower_joint_stage_start">[0.90, 0.72, 0.48, 0.25]</rosparam>
    <rosparam param="lower_joint_stage_full">[1.00, 0.94, 0.78, 0.55]</rosparam>
    <param name="arm_reference_tracking_qp_limit" value="0.06" type="double" />
    <param name="lower_reference_tracking_qp_limit" value="0.08" type="double" />
    <param name="reference_tracking_recovery_arm_limit" value="0.07" type="double" />
    <param name="reference_tracking_recovery_lower_limit" value="0.05" type="double" />
    <param name="reference_tracking_recovery_dwell" value="0.40" type="double" />
    <param name="orientation_tracking_full_error" value="0.06" type="double" />
    <param name="orientation_tracking_zero_error" value="0.16" type="double" />
    <param name="orientation_joint_margin_zero" value="0.02" type="double" />
    <param name="orientation_joint_margin_full" value="0.15" type="double" />
    <param name="secondary_correction_regularization" value="1e-6" type="double" />
    <param name="lower_directional_effectiveness_start" value="0.02" type="double" />
    <param name="lower_directional_effectiveness_full" value="0.15" type="double" />
    <param name="base_admission_dwell_time" value="0.40" type="double" />
    <param name="base_admission_on_threshold" value="0.10" type="double" />
    <param name="base_admission_off_threshold" value="0.03" type="double" />
    <!-- 400062 permits measured arm error up to 0.15 rad at PREPARE completion. -->
    <param name="preparation_measured_position_tolerance" value="$(eval 0.15 if int(arg('robot_version')) == 400062 else 0.06)" type="double" />
    <rosparam param="preparation_arm_position">[0.2618, 0.0, 0.0, -0.5236, 0.0, 0.0, 0.0, 0.2618, 0.0, 0.0, -0.5236, 0.0, 0.0, 0.0]</rosparam>
    <param name="translation_singularity_activation_sigma" value="0.060" type="double" />
    <param name="translation_singularity_safe_sigma" value="0.035" type="double" />
    <param name="translation_singularity_escape_sigma" value="0.015" type="double" />
    <param name="translation_singularity_gain" value="3.0" type="double" />
    <param name="singularity_gradient_step" value="0.002" type="double" />
    <param name="singularity_gradient_min_norm" value="0.001" type="double" />
    <param name="natural_escape_speed" value="0.40" type="double" />
    <param name="nominal_arm_reach" value="$(arg velocity_ik_nominal_arm_reach)" type="double" />
    <param name="selected_reach_reserve" value="$(arg velocity_ik_selected_reach_reserve)" type="double" />
    <rosparam param="joint_safe_range_ratios" subst_value="true">$(arg velocity_ik_joint_safe_range_ratios)</rosparam>
    <rosparam param="joint_safe_center" subst_value="true">$(arg velocity_ik_joint_safe_center)</rosparam>
    <param name="use_legacy_shoulder_pitch_cap" value="$(arg limit_shoulder_pitch_upper)" type="bool" />
    <param name="legacy_shoulder_pitch_upper" value="$(arg shoulder_pitch_upper_limit)" type="double" />
    <rosparam command="load" file="$(find wheel_arm_abs_vel)/config/fixed_base_18d.yaml" />
    <param name="wrist_envelope/enabled" value="$(arg wrist_envelope_enabled)" type="bool" />
    <param name="continuous_reference_enabled" value="$(arg continuous_reference_enabled)" />
    <param name="adaptive_reference/enabled" value="$(arg adaptive_reference_enabled)" />
    <param name="innovation_reference/enabled" value="$(arg innovation_reference_enabled)" />
    <param name="hand_reference_frequency" value="$(arg hand_reference_frequency)" />
    <param name="torso_reference_frequency" value="$(arg torso_reference_frequency)" />
    <rosparam command="load" file="$(arg operating_temporal_config)" />
    <param name="orientation_reference_mode" value="$(arg orientation_reference_mode)" />
    <param name="hand_position_cutoff_hz" value="$(arg hand_position_cutoff_hz)" />
    <param name="hand_orientation_cutoff_hz" value="$(arg hand_orientation_cutoff_hz)" />
    <param name="joint_jerk/enabled" value="$(arg joint_jerk_enabled)" type="bool" />
    <rosparam command="load" file="$(find wheel_arm_abs_vel)/config/teleop_continuity.yaml" />
    <rosparam command="load" file="$(find wheel_arm_abs_vel)/config/execution_governor.yaml" />
    <param name="execution_governor/enabled" value="$(arg execution_governor_enabled)" type="bool" />
    <!-- Override YAML defaults AND stale parameter-server flags explicitly. -->
    <param name="operating_envelope/enabled" value="$(arg operating_envelope_enabled)" type="bool" />
    <param name="temporal_cost/enabled" value="$(arg temporal_cost_enabled)" type="bool" />
    <param name="operating_diagnostics/enabled" value="$(arg operating_diagnostics_enabled)" type="bool" />
  </node>
  <node pkg="wheel_arm_abs_vel" type="ik_ros_velocity.py" name="ik_ros_uni" args=" --version $(arg version) --ctrl_arm_idx $(arg ctrl_arm_idx) --ik_type_idx $(arg ik_type_idx) --control_torso=$(arg control_torso) --control_finger_type=$(arg control_finger_type) --predict_gesture=$(arg predict_gesture) --ee_type=$(arg ee_type) --hand_reference_mode=$(arg hand_reference_mode) --use_two_stage_ik=$(arg use_two_stage_ik)" output="screen" unless="$(arg use_cpp_incremental_ik)" respawn="false" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh mapper')" required="true">
    <!-- Transport/diagnostics only; preserve mapping, filters and lifecycle checks. -->
    <param name="use_compact_ik_status" value="true" type="bool" />
    <param name="noncontrol_publish_async" value="true" type="bool" />
    <!-- Keep the original Python startup/hand logic; remap its owner observer only. -->
    <remap from="/whole_body_velocity_ik/reference/execution_owner" to="$(eval '/whole_body_velocity_ik/reference/execution_owner' + ('/shm_mirror' if arg('reference_transport') == 'shm' else ''))" />
    <param name="dexhand_front_trigger" value="$(arg dexhand_front_trigger)" type="bool" />
    <rosparam command="load" file="$(find wheel_arm_abs_vel)/config/vr_kalman.yaml" />
    <param name="vr_kalman_flattening/enabled" value="$(eval arg('filter_tuning_enabled') and arg('vr_kalman_flattening_enabled'))" type="bool" />
    <param name="vr_kalman_enabled" value="$(arg vr_kalman_enabled)" />
    <!-- Tiny covariance solves must not create a BLAS thread pool. -->
    <env name="OPENBLAS_NUM_THREADS" value="1" />
    <env name="OMP_NUM_THREADS" value="1" />
    <rosparam command="load" file="$(arg velocity_tcp_geometry_file)" if="$(eval arg('velocity_tcp_geometry_file') != '')" />
    <param name="use_arm_collision" value="$(arg use_arm_collision)" />
    <param name="enable_ik_velocity_limit" value="$(arg enable_ik_velocity_limit)" type="bool" />
    <param name="enable_velocity_ik_takeover" value="$(arg enable_velocity_ik_takeover)" type="bool" />
    <param name="sg100_enabled" value="$(arg sg100_enabled)" type="bool" />
    <param name="whole_body_shadow_isolate_position_ik" value="$(arg whole_body_shadow_isolate_position_ik)" type="bool" />
    <param name="enable_position_ik_status_log" value="$(arg enable_position_ik_status_log)" type="bool" />
    <param name="publish_tracking_mapping_debug" value="$(arg publish_tracking_mapping_debug)" type="bool" />
    <param name="tracking_source_mode" value="$(arg tracking_source_mode)" type="string" />
    <param name="enable_absolute_target_alignment" value="$(arg enable_absolute_target_alignment)" type="bool" />
    <param name="enable_absolute_start_gap_check" value="$(arg enable_absolute_start_gap_check)" type="bool" />
    <param name="absolute_enable_max_position_error" value="$(arg absolute_enable_max_position_error)" type="double" />
    <param name="absolute_enable_max_orientation_error" value="$(arg absolute_enable_max_orientation_error)" type="double" />
    <param name="absolute_enable_max_vr_age" value="$(arg absolute_enable_max_vr_age)" type="double" />
    <param name="absolute_enable_max_joint_state_age" value="$(arg absolute_enable_max_joint_state_age)" type="double" />
    <param name="absolute_enable_mode_timeout" value="$(arg absolute_enable_mode_timeout)" type="double" />
    <param name="absolute_enable_service_timeout" value="$(arg absolute_enable_service_timeout)" type="double" />
    <param name="absolute_enable_exit_mode" value="$(arg absolute_enable_exit_mode)" type="int" />
    <param name="enable_absolute_discontinuity_guard" value="$(arg enable_absolute_discontinuity_guard)" type="bool" />
    <param name="absolute_max_tcp_position_step" value="$(arg absolute_max_tcp_position_step)" type="double" />
    <param name="absolute_max_tcp_orientation_step" value="$(arg absolute_max_tcp_orientation_step)" type="double" />
    <param name="absolute_max_joint_step" value="$(arg absolute_max_joint_step)" type="double" />
    <param name="absolute_ik_trust_region_step" value="$(arg absolute_ik_trust_region_step)" type="double" />
    <param name="absolute_hard_recovery_successes" value="$(arg absolute_hard_recovery_successes)" type="int" />
    <param name="absolute_hard_target_max_step" value="$(arg absolute_hard_target_max_step)" type="double" />
    <param name="absolute_hard_recovery_max_offset" value="$(arg absolute_hard_recovery_max_offset)" type="double" />
    <param name="absolute_hard_recovery_stability_step" value="$(arg absolute_hard_recovery_stability_step)" type="double" />
    <param name="absolute_execution_max_joint_velocity" value="$(arg absolute_execution_max_joint_velocity)" type="double" />
    <param name="absolute_execution_max_joint_acceleration" value="$(arg absolute_execution_max_joint_acceleration)" type="double" />
    <param name="absolute_execution_min_joint_limit_margin" value="$(arg absolute_execution_min_joint_limit_margin)" type="double" />
    <param name="tracking_rearm_stable_frames" value="$(arg tracking_rearm_stable_frames)" type="int" />
    <param name="velocity_tcp_forearm_length" value="0.45" type="double" />
    <param name="velocity_tcp_geometry_id" value="V$(arg robot_version)_CONFIGURED_FULL_FOREARM_0450_UNCALIBRATED_V1" type="str" />
    <env name="ROBOT_VERSION" value="$(arg robot_version)" />
  </node>
  <node pkg="wheel_arm_abs_vel" type="humanoid_quest_absolute_control" name="humanoid_quest_control_with_arm" output="screen" if="$(eval wheel_ik or arg('use_arm_only_ik'))" launch-prefix="$(find wheel_arm_abs_vel)/scripts/whole_body_ik_runtime.sh background bash -o pipefail $(find humanoid_controllers)/scripts/start_node.sh" respawn="false" required="true">
    <param name="robot_version" value="$(arg robot_version)" type="int" />
    <param name="robot_type" value="1" type="int" />
    <param name="referenceFile" value="$(find humanoid_controllers)/config/kuavo_v$(arg robot_version)/command/reference.info" type="str" />
    <param name="gaitCommandFile" value="$(find humanoid_controllers)/config/kuavo_v$(arg robot_version)/command/gait.info" type="str" />
    <remap from="/cmd_vel" to="$(eval '/whole_body_velocity_ik/disabled_base_cmd_vel' if arg('enable_velocity_ik_takeover') else '/cmd_vel')" />
  </node>
  <param name="wheel_ik" value="$(arg wheel_ik)" />
  <param name="use_pico" value="$(arg use_pico)" />
  <node pkg="wheel_arm_abs_vel" type="monitor_quest3_velocity.py" args="$(arg ip_address)" name="monitor_quest3" output="screen" if="$(eval arg('input_source') == 'quest' and not arg('use_cpp_monitor'))" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh quest')">
    <param name="control_finger_tf_enabled" value="$(arg predict_gesture)" type="bool" />
    <param name="enable_head_control" value="$(arg enable_head_control)" />
  </node>
  <node pkg="noitom_hi5_hand_udp_python" type="monitor_quest3_cpp" args="$(arg ip_address)" name="monitor_quest3_cpp" output="screen" if="$(eval arg('input_source') == 'quest' and arg('use_cpp_monitor'))" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')">
    <param name="enable_head_control" value="$(arg enable_head_control)" />
  </node>
  <node pkg="wheel_arm_abs_vel" type="robot_state_server_velocity.py" name="robot_state_server" output="screen" if="$(eval arg('input_source') == 'quest' and arg('use_cpp_monitor'))" launch-prefix="$(find wheel_arm_abs_vel)/scripts/whole_body_ik_runtime.sh background /usr/bin/python3 $(find wheel_arm_abs_vel)/scripts/sidecar_runtime.py" />
  <include file="$(find wheel_arm_abs_vel)/launch/pico_input.launch" if="$(eval arg('input_source') == 'pico')">
    <arg name="port" value="$(arg pico_port)" />
    <arg name="peer_ip" value="$(arg pico_peer_ip)" />
    <arg name="advertise_ip" value="$(arg pico_advertise_ip)" />
    <arg name="broadcast_ip" value="$(arg pico_broadcast_ip)" />
    <arg name="calibration_file" value="$(arg pico_calibration_file)" />
    <arg name="enable_head_control" value="$(arg enable_head_control)" />
  </include>
  <node pkg="motion_capture_ik" type="torso_joystick_node.py" name="torso_joystick_node" output="screen" if="$(arg single_hand_mode)" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <node pkg="noitom_hi5_hand_udp_python" type="webrtc_videostream.py" name="webrtc_videostream" output="screen" args="$(arg camera_publisher_name) $(arg ip_address)" if="$(arg enable_videostream)" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <!-- Acquisition lifetime follows this launch, never an earlier SSH session. -->
  <node pkg="wheel_arm_abs_vel" type="run_scheduler_observer.py" name="kuavo_scheduler_flight_observer" output="screen" respawn="false" required="false" if="$(eval arg('enable_velocity_ik_takeover') and arg('wheel_ik') and not arg('use_cpp_incremental_ik'))" launch-prefix="$(eval find('wheel_arm_abs_vel') + '/scripts/whole_body_ik_runtime.sh background')" />
  <!-- Read at node startup; load last so included YAML cannot override audit rates. -->
  <include file="$(find wheel_arm_abs_vel)/launch/bypass_communication_profile.launch" if="$(eval arg('wheel_ik') and not arg('use_cpp_incremental_ik') and arg('enable_velocity_ik_takeover'))">
    <arg name="full_rate_audit" value="$(arg communication_full_rate_audit)" />
    <arg name="second_round_enabled" value="$(arg communication_second_round_enabled)" />
  </include>
  <include file="$(find wheel_arm_abs_vel)/launch/j3_overshoot_profile.launch">
    <arg name="enabled" value="$(eval arg('j3_overshoot_profile') and int(arg('robot_version')) in (62, 63) and arg('wheel_ik') and not arg('use_cpp_incremental_ik') and arg('enable_velocity_ik_takeover'))" />
    <arg name="kd" value="$(arg j3_kd)" />
  </include>
  <arg name="absolute_launch_contract" value="$(eval {'supported': 'wheel_arm_abs_vel_s62'}['supported' if (int(arg('robot_version')) in (62, 63, 400062) and arg('wheel_ik') and arg('enable_velocity_ik_takeover') and not arg('use_cpp_incremental_ik') and not arg('use_arm_only_ik') and not arg('legacy_pico_profile')) else 'Private absolute input requires S62/S63/400062 wheel_ik=true takeover=true; incremental/arm-only/legacy profiles are unsupported'])" />
</launch>
