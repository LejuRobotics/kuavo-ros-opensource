<mujoco model="kuavo v56 scene seat adjust">
  <include file="biped_s56.xml"/>

  <statistic center="-0.2 0 0.55" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="seat_mat" rgba="0.75 0.52 0.35 1"/>
    <material name="seat_mat_01" rgba="0.55 0.72 0.45 1"/>
    <material name="seat_geom_mat" rgba="0.58 0.25 0.85 0.35"/>
    <mesh name="mesh_k5_part_01" file="../xml/K5/meshes/part_01.stl" scale="0.001 0.001 0.001"/>
    <mesh name="mesh_k5_part_03" file="../xml/K5/meshes/part_03.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      K5 装配根节点 k5_seat_asm（世界锚点）；其下全部为相对坐标。
      世界系换算：world = asm_world + local，asm_world=(-0.25, 0, 0.895501)
      水平面 ⊥Z：椅面 local z=-461 | 放脚 -767.5 | 扶手 -152.5 | 箱顶 -63+832.5=769.5→world 1.665
      椅背 local x=-85 mm；尺寸 size 均为 MuJoCo 半轴。
    -->
    <body name="k5_seat_asm" pos="-0.22 0 0.895501" quat="1 0 0 0">
      <body name="k5_part_03" pos="0 0 0" quat="1 0 0 0">
        <inertial pos="0 0 0" mass="1549.478082" diaginertia="371.180706 321.920238 84.614393"/>
        <geom name="viz_k5_part_03" type="mesh" mesh="mesh_k5_part_03" material="seat_mat"
              contype="0" conaffinity="0" group="1"/>
      </body>
      <body name="k5_part_01" pos="-0.031 0 -0.0005" quat="1 0 0 0">
        <inertial pos="0 0 0" mass="226.403370" diaginertia="56.358135 47.994194 12.523121"/>
        <geom name="viz_k5_part_01" type="mesh" mesh="mesh_k5_part_01" material="seat_mat_01"
              contype="0" conaffinity="0" group="1"/>
      </body>

      <!-- 平面 geom：统一 group=1，碰撞+可视化合一；z 半轴 12mm 便于看见，顶面高度不变 -->
      <geom name="k5_seat_plane" type="box" pos="0.030 0 -0.472001" size="0.115 0.184 0.012"
            contype="1" conaffinity="1" condim="6" friction="1 1 0.001"
            solref="0.002 1" solimp="0.99 0.99 0.001" group="1" material="seat_geom_mat"/>

      <geom name="k5_foot_plane_l" type="box" pos="0 0.105 -0.778501" size="0.085 0.079 0.012"
            contype="1" conaffinity="1" condim="3" group="1" material="seat_geom_mat"/>
      <geom name="k5_foot_plane_r" type="box" pos="0 -0.105 -0.778501" size="0.085 0.079 0.012"
            contype="1" conaffinity="1" condim="3" group="1" material="seat_geom_mat"/>

      <geom name="k5_armrest_l" type="box" pos="0.025 0.204 -0.163501" size="0.160 0.02 0.012"
            contype="1" conaffinity="1" condim="3" group="1" material="seat_geom_mat"/>
      <geom name="k5_armrest_r" type="box" pos="0.025 -0.204 -0.163501" size="0.160 0.02 0.012"
            contype="1" conaffinity="1" condim="3" group="1" material="seat_geom_mat"/>

      <geom name="k5_seat_back" type="box" pos="-0.085 0 -0.063001" size="0.005 0.224 0.8325"
            contype="1" conaffinity="1" condim="3" group="1" material="seat_geom_mat"/>

      <!-- 箱顶左右顶点：绳锚点（local = 椅背顶边 y=±0.224, z=0.769499） -->
      <!-- <site name="rope_anchor_l" pos="0.185 0.224 0.769499" size="0.018" rgba="1 0.82 0.1 1" group="1"/>
      <site name="rope_anchor_r" pos="0.185 -0.224 0.769499" size="0.018" rgba="1 0.82 0.1 1" group="1"/> -->
    </body>

  </worldbody>

  <!--
    base 双绳：绳长 = range 第二个数(m)。slack 段无力，仅当两 site 距离 > 绳长时 limit 约束才拉。
    勿设 stiffness/damping（那是沿绳全程弹簧，不是“超绳长才拉”）。
    限位刚度由 solreflimit 控制；改 XML 后 Reload。
  -->
  <!-- <tendon>
    <spatial name="seat_rope_l" limited="true" range="0 1" stiffness="0" damping="0"
             width="0.006" rgba="0.95 0.78 0.12 1" solreflimit="0.005 1" solimplimit="0.95 0.99 0.001">
      <site site="rope_anchor_l"/>
      <site site="rope_attach"/>
    </spatial>
    <spatial name="seat_rope_r" limited="true" range="0 1" stiffness="0" damping="0"
             width="0.006" rgba="0.95 0.78 0.12 1" solreflimit="0.005 1" solimplimit="0.95 0.99 0.001">
      <site site="rope_anchor_r"/>
      <site site="rope_attach"/>
    </spatial>
  </tendon> -->

  <!-- v56 sit_joint_pos + sit_base_position/orientation（pitch 20.31 deg） -->
  <keyframe>
    <key name="sit"
      qpos="
    -0.25 0 0.655
    0.984556 0 0.175043 0
    0.01 0.006 -1.92 1.80 -0.229 -0.01
    0.01 0.006 -1.92 1.80 -0.229 -0.01
    0
    -1.0 0.0 -0.0 -0.57 0.0 0.0 0.0
    -1.00 -0.0  0.0 -0.57 0.0 0.0 0.0
    0 0"/>
  </keyframe>

</mujoco>
