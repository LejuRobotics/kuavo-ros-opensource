<?xml version='1.0' encoding='utf-8'?>
<robot name="biped_s62">
  <mujoco>
    <compiler meshdir="../meshes/"
              balanceinertia="true"
              discardvisual="false" />
  </mujoco>
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0"
              rpy="0 0 0" />
      <mass value="0.0" />
      <inertia ixx="0.0"
               ixy="0.0"
               ixz="0.0"
               iyy="0.0"
               iyz="0.0"
               izz="0.0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"
              rpy="0 0 0" />
      <geometry>
        <mesh filename="../../meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>

  <link
    name="waist_yaw_link">
    <inertial>
      <origin
        xyz="-0.00205700 -0.00093254 0.15776501" 
        rpy="0 0 0" />
      <mass
        value="12.64200813" />
      <inertia
        ixx="0.23016616"
        ixy="0.00023876"
        ixz="-0.00135390"
        iyy="0.14716611"
        iyz="0.00037425"
        izz="0.15978860" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://kuavo_assets/models/biped_s62/meshes/torso.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.6" />
      </geometry>
    </collision>
  </link>
  <joint
    name="waist_yaw_joint"
    type="revolute">
    <origin
      xyz="0 0 0.25" 
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="waist_yaw_link" />
    <axis
      xyz="0 0 1" />
    <limit lower="-3.14159265358979" upper="3.14159265358979" effort="618.48" velocity="25.33" />
    <dynamics damping="0.0" friction="0.0" />
  </joint>
  <!-- 固定参考坐标系：与 zarm_l1_joint 在同一位置，但不随关节转动 -->
  <link name="zarm_l1_ref_link">
    <visual>
      <!-- 不需要几何，只作为一个纯参考坐标系使用 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
      <material name="zarm_l1_ref_material">
        <color rgba="0 1 0 0" />
      </material>
    </visual>
  </link>
  <joint name="zarm_l1_ref_joint" type="fixed">
    <!-- 位置与 zarm_l1_joint 的 origin 完全一致 -->
    <origin xyz="0.0 0.2527 0.242" rpy="0 0 0" />
    <parent link="waist_yaw_link" />
    <child link="zarm_l1_ref_link" />
  </joint>

  <!-- ============ l_arm_pitch ============ -->
  <!-- 坐标系：l_arm_pitch_roll_yaw -->
  <link
    name="zarm_l1_link">
    <inertial>
      <!-- 质心：( 0.00140078, -0.01023500, -0.00030514 ) -->
      <origin xyz="0.00140078 -0.01023500 -0.00030514" rpy="0 0 0" />
      <!-- 质量：1.01295970 kg -->
      <mass value="1.01296" />
      <!-- ✅ 由重心决定，并且对齐输出的坐标系。（使用负张量记数法。） -->
