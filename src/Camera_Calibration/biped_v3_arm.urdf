    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://kuavo_assets/models/biped_s49/meshes/l_hand_tripod.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://kuavo_assets/models/biped_s49/meshes/l_hand_tripod.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="l_hand_tripod_joint"
    type="fixed">
    <origin
      xyz="0.0 0.0 0.0"
      rpy="0.0 0.0 0.0" />
    <parent
      link="zarm_l7_link" />
    <child
      link="l_hand_tripod" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link
    name="l_hand_camera">
    <inertial>
      <origin
