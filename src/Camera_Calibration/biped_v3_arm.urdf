  </link>
  <joint name="zhead_1_joint" type="revolute">
    <origin xyz="-0.003 0.0 0.3715" rpy="0 0 0" />
    <parent link="waist_yaw_link" />
    <child link="zhead_1_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5707963267949" upper="1.5707963267949" effort="1.5" velocity="5.23" />
