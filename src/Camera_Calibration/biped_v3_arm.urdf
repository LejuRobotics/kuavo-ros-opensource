  <!-- ====================== 追加：左手腕相机（用于棋盘标定） ====================== -->
  <!-- 完全复刻 biped_s49.urdf 的 l_hand_tripod / l_hand_camera 结构，并额外提供 optical_frame 以对齐在线相机 frame_id -->

  <link name="l_hand_tripod">
    <inertial>
      <origin
        xyz="0.0653430919091347 -0.00776026775236038 -0.0648805742218587"
        rpy="0 0 0" />
      <mass
        value="0.0342669089979502" />
      <inertia
        ixx="1.59850149176395E-05"
        ixy="-5.29139847447712E-06"
        ixz="1.78131910236665E-05"
        iyy="9.8758759051122E-05"
        iyz="-2.71719747666022E-07"
        izz="9.75721402715185E-05" />
