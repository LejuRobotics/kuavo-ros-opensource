    <dynamics damping="0.2" friction="0.0" />
  </joint>

  <!-- s52 里的 head camera：camera_base 掛在 zhead_2_link 下 -->
  <link name="camera_base">
    <inertial>
      <origin xyz="-0.0109467295615343 -0.00025332024893314 0.000333522154238597" rpy="0 0 0" />
      <mass value="0.0482361371130408" />
