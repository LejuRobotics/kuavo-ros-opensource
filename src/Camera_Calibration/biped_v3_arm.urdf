  <link name="left_wrist_camera_color_optical_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
      <material name="left_wrist_camera_optical_material">
        <color rgba="0 1 0 0" />
      </material>
    </visual>
  </link>
  <joint name="left_wrist_camera_color_optical_frame_joint" type="fixed">
    <!-- 标准光学坐标变换：R = Rz(-90°) * Rx(-90°) -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
    <parent link="l_hand_camera" />
    <child link="left_wrist_camera_color_optical_frame" />
  </joint>
  <!-- ====================== 追加：头部链 + 相机与棋盘（用于棋盘标定） ====================== -->
  <!-- 以下定义直接从 biped_s52.urdf 拷贝（zhead_1_link/zhead_2_link/camera_base），避免手写几何 -->

  <link name="zhead_1_link">
    <inertial>
      <origin xyz="0.00031003 -0.00324665 0.0949507" rpy="0 0 0" />
      <mass value="0.87117795" />
      <inertia ixx="0.00204799" ixy="0" ixz="0" iyy="0.00196073" iyz="0" izz="0.0006154" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
