          vertex="0.054529 -0.007179 0.000  0.054529 0.007179 0.000
                  0.042632 0.005613 0.000  0.042632 -0.005613 0.000
                  0.054529 -0.007179 0.060  0.054529 0.007179 0.060
                  0.042632 0.005613 0.060  0.042632 -0.005613 0.060"
          face="0 1 2  0 2 3  4 7 6  4 6 5
                0 4 5  0 5 1  1 5 6  1 6 2
                2 6 7  2 7 3  3 7 4  3 4 0"/>
  </asset>

