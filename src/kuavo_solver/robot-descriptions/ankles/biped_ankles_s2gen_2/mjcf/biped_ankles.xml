    <mesh name="l_l_bar" file="l_r_bar.STL"/>
    <mesh name="l_l_tendon" file="l_r_tendon.STL"/>
    <mesh name="l_r_bar" file="l_l_bar.STL"/>
    <mesh name="l_r_tendon" file="l_l_tendon.STL"/>

