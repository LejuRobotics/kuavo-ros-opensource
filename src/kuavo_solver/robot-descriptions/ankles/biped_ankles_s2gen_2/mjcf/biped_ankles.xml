          <site name="l_l_eq" group="0" pos="0.02400533 0.0207 0.00300002" type="sphere" rgba="0.8 0.2 0.4 1" size="0.0065"/>
          <site name="l_r_eq" group="0" pos="0.02400533 -0.0186 0.00300002" type="sphere" rgba="0.8 0.2 0.4 1" size="0.0065"/>
        </body>
      </body>

      <!-- 左外侧 bar (llbar, 对应右脚 rrbar) -->
      <body name="l_l_bar" pos="0.061013 0 -0.16157">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="l_l_bar" pos="0 0 0" axis="1 0 0" limited="true" range="-2.5 2.5"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="l_l_bar"/>
        <body name="l_l_tendon" pos="0 0.0207 0.12374818">
          <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="l_l_tendon" pos="-0.00019865 0.002728 -0.12658908" type="ball"/>
          <geom type="mesh" pos="-0.00019865 0.002728 -0.12658908" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="l_l_tendon"/>
          <site name="l_l_tendon" group="0" pos="-0.00019865 0.002728 -0.12658908" type="sphere" rgba="0.2 0.6 0.8 1" size="0.0065"/>
        </body>
      </body>

      <!-- 左内侧 bar (lrbar, 对应右脚 rlbar) -->
      <body name="l_r_bar" pos="0.065058 0 -0.10371">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="l_r_bar" pos="0 0 0" axis="1 0 0" limited="true" range="-2.5 2.5"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="l_r_bar"/>
        <body name="l_r_tendon" pos="0 -0.0186 0.18055678">
          <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="l_r_tendon" pos="-0.00023541 -0.004757 -0.18392338" type="ball"/>
          <geom type="mesh" pos="-0.00023541 -0.004757 -0.18392338" euler="0 0.069813 0" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="l_r_tendon"/>
          <site name="l_r_tendon" group="0" pos="-0.00023541 -0.004757 -0.18392338" type="sphere" rgba="0.2 0.6 0.8 1" size="0.0065"/>
        </body>
      </body>
    </body>

    <!-- RIGHT FOOT (AxisOffset 布局, 更新自 s224 URDF) -->
    <body name="r_knee" pos="0 -0.15 0">
      <site name="r_dummy"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.001 0.001 0.001"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="r_knee"/>

      <body name="r_foot_pitch" pos="0.03 0 -0.276">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="r_foot_pitch" pos="0 0 0" axis="0 1 0" range="-0.872664625997165 0.523598775598299" armature="0.01" damping="0.01" />
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="r_foot_pitch"/>

        <body name="r_foot_roll" pos="0 0 -0.018">
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
          <joint name="r_foot_roll" pos="0 0 0" axis="1 0 0" range="-0.261799387799149 0.261799387799149" armature="0.01" damping="0.01" />
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="r_foot_roll"/>
          <!-- 右脚 eq 点 -->
          <site name="r_l_eq" group="0" pos="0.02400533 0.0186 0.00300002" type="sphere" rgba="0.8 0.2 0.4 1" size="0.0065"/>
          <site name="r_r_eq" group="0" pos="0.02400533 -0.0207 0.00300002" type="sphere" rgba="0.8 0.2 0.4 1" size="0.0065"/>
        </body>
      </body>

      <!-- 右内侧 bar (rlbar) -->
      <body name="r_l_bar" pos="0.065058 0 -0.10371">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="r_l_bar" pos="0 0 0" axis="1 0 0" limited="true" range="-2.5 2.5"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="r_l_bar"/>
        <body name="r_l_tendon" pos="0 0.0186 0.18055678">
