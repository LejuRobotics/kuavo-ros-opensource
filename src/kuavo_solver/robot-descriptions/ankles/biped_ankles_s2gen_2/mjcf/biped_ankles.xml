        </body>
      </body>

      <!-- 右外侧 bar (rrbar) -->
      <body name="r_r_bar" pos="0.061013 0 -0.16157">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="r_r_bar" pos="0 0 0" axis="1 0 0" limited="true" range="-2.5 2.5"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="r_r_bar"/>
        <body name="r_r_tendon" pos="0 -0.0207 0.12374818">
          <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="r_r_tendon" pos="-0.00019865 -0.002728 -0.12658908" type="ball"/>
          <geom type="mesh" pos="-0.00019865 -0.002728 -0.12658908" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="r_r_tendon"/>
          <site name="r_r_tendon" group="0" pos="-0.00019865 -0.002728 -0.12658908" type="sphere" rgba="0.2 0.6 0.8 1" size="0.0065"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="l_l_eq" body1="l_foot_roll" body2="l_l_tendon" anchor="0.02400533 0.0207 0.00300002" solref="0.001 1" />
    <connect name="l_r_eq" body1="l_foot_roll" body2="l_r_tendon" anchor="0.02400533 -0.0186 0.00300002" solref="0.001 1" />
    <connect name="r_l_eq" body1="r_foot_roll" body2="r_l_tendon" anchor="0.02400533 0.0186 0.00300002" solref="0.001 1" />
    <connect name="r_r_eq" body1="r_foot_roll" body2="r_r_tendon" anchor="0.02400533 -0.0207 0.00300002" solref="0.001 1" />
  </equality>

  <actuator>
    <position name="l_l_bar" joint="l_l_bar" kp="20" kv="4" ctrlrange="-2.5 2.5" forcerange="-30 30"/>
    <position name="l_r_bar" joint="l_r_bar" kp="20" kv="4" ctrlrange="-2.5 2.5" forcerange="-30 30"/>
    <general name="l_foot_pitch" joint="l_foot_pitch" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
    <general name="l_foot_roll" joint="l_foot_roll" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
    <position name="r_l_bar" joint="r_l_bar" kp="20" kv="4" ctrlrange="-2.5 2.5" forcerange="-30 30"/>
    <position name="r_r_bar" joint="r_r_bar" kp="20" kv="4" ctrlrange="-2.5 2.5" forcerange="-30 30"/>
    <general name="r_foot_pitch" joint="r_foot_pitch" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
    <general name="r_foot_roll" joint="r_foot_roll" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
  </actuator>

  <sensor>
    <actuatorfrc name="l_foot_pitch_torque" actuator="l_foot_pitch"/>
    <actuatorfrc name="l_foot_roll_torque" actuator="l_foot_roll"/>
    <actuatorfrc name="l_l_bar_torque" actuator="l_l_bar"/>
    <actuatorfrc name="l_r_bar_torque" actuator="l_r_bar"/>
    <actuatorfrc name="r_foot_pitch_torque" actuator="r_foot_pitch"/>
    <actuatorfrc name="r_foot_roll_torque" actuator="r_foot_roll"/>
    <actuatorfrc name="r_l_bar_torque" actuator="r_l_bar"/>
    <actuatorfrc name="r_r_bar_torque" actuator="r_r_bar"/>
  </sensor>
</mujoco>
