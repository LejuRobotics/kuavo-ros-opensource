<?xml version="1.0"?>
<mujoco model="s2gen_2_ankles">
  <compiler angle="radian" meshdir="../../../../../kuavo_assets/models/biped_s17/meshes/"/>
  <option>
    <flag gravity="disable" />
  </option>

  <default>
    <joint armature="0.01" damping="0.8" frictionloss="0.08" />
  </default>

  <asset>
    <mesh name="l_foot_pitch" file="l_foot_pitch.STL"/>
    <mesh name="l_foot_roll" file="l_foot_roll.STL"/>
    <mesh name="l_knee" file="l_knee.STL"/>
