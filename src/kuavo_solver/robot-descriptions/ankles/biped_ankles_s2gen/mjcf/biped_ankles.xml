          <site name="l_r_eq" group="0" pos="-0.03919 -0.03 0.008" type="sphere" rgba="0.8 0.2 0.4 1" size="0.0065"/>
        </body>
      </body>

      <!-- 左外侧 bar (llbar): barpivot 在 foot_eq, bar 延伸到 bar 位置 -->
      <!-- barpivot: foot_eq anchor = (-0.03919, 0.03, 0.008) in foot_roll frame -->
      <body name="l_l_bar_pivot" pos="-0.03919 0.03 0.008">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="l_l_bar_pivot" pos="0 0 0" type="ball" range="0 0"/>
        <!-- bar body: 从 foot_eq 延伸到 bar 位置 (0, 0.03, -0.138) -->
        <!-- bar offset = (0.03919, 0, -0.146) -->
        <body name="l_l_bar" pos="0.03919 0 -0.146">
          <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="l_l_bar" pos="0 0 0" axis="1 0 0" limited="true" range="-0.387637626867941 0.983667566424004"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.647059 0.619608 0.588235 1" mesh="l_l_bar"/>
