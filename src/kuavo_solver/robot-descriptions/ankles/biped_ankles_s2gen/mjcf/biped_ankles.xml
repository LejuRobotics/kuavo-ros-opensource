  <equality>
    <connect name="l_l_eq" body1="l_foot_roll" body2="l_l_tendon" anchor="-0.03919 0.03 0.008" solref="0.001 1" />
    <connect name="l_r_eq" body1="l_foot_roll" body2="l_r_tendon" anchor="-0.03919 -0.03 0.008" solref="0.001 1" />
    <connect name="r_l_eq" body1="r_foot_roll" body2="r_l_tendon" anchor="-0.03919 -0.03 0.008" solref="0.001 1" />
    <connect name="r_r_eq" body1="r_foot_roll" body2="r_r_tendon" anchor="-0.03919 0.03 0.008" solref="0.001 1" />
  </equality>

  <actuator>
    <position name="l_l_bar" joint="l_l_bar" kp="0.1" kv="0.1" ctrlrange="-0.387637626867941 0.983667566424004" forcerange="-30 30"/>
    <position name="l_r_bar" joint="l_r_bar" kp="0.1" kv="0.1" ctrlrange="-0.991347015132779 0.383448836663154" forcerange="-30 30"/>
    <general name="l_foot_pitch" joint="l_foot_pitch" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
    <general name="l_foot_roll" joint="l_foot_roll" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
    <position name="r_l_bar" joint="r_l_bar" kp="0.1" kv="0.1" ctrlrange="-0.383448836663154 0.991347015132779" forcerange="-30 30"/>
