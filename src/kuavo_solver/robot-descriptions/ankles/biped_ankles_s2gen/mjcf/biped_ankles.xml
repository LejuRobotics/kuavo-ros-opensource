    <mesh name="r_foot_roll" file="/root/workspace/kuavo-ros-control/src/kuavo_assets/models/biped_s13/meshes/r_foot_roll.STL"/>
    <mesh name="r_foot_roll_big" file="/root/workspace/kuavo-ros-control/src/kuavo_assets/models/biped_s13/meshes/r_foot_roll_big.STL"/>
    <mesh name="r_knee" file="/root/workspace/kuavo-ros-control/src/kuavo_assets/models/biped_s13/meshes/r_knee.STL"/>
    <mesh name="r_l_bar" file="/root/workspace/kuavo-ros-control/src/kuavo_assets/models/biped_s13/meshes/r_l_bar.STL"/>
