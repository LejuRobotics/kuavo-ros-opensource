    <general name="r_foot_roll" joint="r_foot_roll" gaintype="fixed" gainprm="1" biastype="none" biasprm="0 0" ctrlrange="-10. 10."/>
  </actuator>

  <sensor>
    <actuatorfrc name="l_foot_pitch_torque" actuator="l_foot_pitch"/>
    <actuatorfrc name="l_foot_roll_torque" actuator="l_foot_roll"/>
    <actuatorfrc name="l_l_bar_torque" actuator="l_l_bar"/>
    <actuatorfrc name="l_r_bar_torque" actuator="l_r_bar"/>
    <actuatorfrc name="r_foot_pitch_torque" actuator="r_foot_pitch"/>
    <actuatorfrc name="r_foot_roll_torque" actuator="r_foot_roll"/>
    <actuatorfrc name="r_l_bar_torque" actuator="r_l_bar"/>
    <actuatorfrc name="r_r_bar_torque" actuator="r_r_bar"/>
