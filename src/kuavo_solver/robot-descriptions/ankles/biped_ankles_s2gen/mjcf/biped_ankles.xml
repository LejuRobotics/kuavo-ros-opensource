            <site name="l_l_tendon" group="0" pos="0 0 -0.097" type="sphere" rgba="0.2 0.6 0.8 1" size="0.0065"/>
          </body>
        </body>
      </body>

      <!-- 左内侧 bar (lrbar): barpivot 在 foot_eq, bar 延伸到 bar 位置 -->
      <!-- barpivot: foot_eq anchor = (-0.03919, -0.03, 0.008) in foot_roll frame -->
      <body name="l_r_bar_pivot" pos="-0.03919 -0.03 0.008">
        <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="l_r_bar_pivot" pos="0 0 0" type="ball" range="0 0"/>
        <!-- bar body: 从 foot_eq 延伸到 bar 位置 (0, -0.03, -0.083) -->
        <!-- bar offset = (0.03919, 0, -0.091) -->
        <body name="l_r_bar" pos="0.03919 0 -0.091">
