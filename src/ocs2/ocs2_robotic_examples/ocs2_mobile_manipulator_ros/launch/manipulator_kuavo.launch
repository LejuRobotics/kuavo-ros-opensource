<launch>
      <!-- Enable rviz visualization -->
      <arg name="rviz"        default="true" />
      <!-- Set nodes on debug mode -->
      <arg name="debug"       default="false" />
      <!-- mpc_type 1 for SQP and 0 for DDP  -->
      <arg name="sqp_mpc"  default="1" />

      <!-- The URDF model of the robot -->
      <arg name="robot_version" default="$(optenv ROBOT_VERSION 40)"/>
      <!-- The URDF model of the robot -->
      <arg name="urdfFile"    value="$(find kuavo_assets)/models/biped_s$(arg robot_version)/urdf/biped_s$(arg robot_version).urdf" />

      <!-- The task file for the mpc. -->
      <!-- <arg name="taskFile"    value="$(find ocs2_mobile_manipulator)/config/kuavo/task.info" /> -->
      <!-- Version is PPPPMMMMN. 200049 is 4.9.2, so compare major, not the raw integer. -->
      <arg name="taskFile"
            default="$(eval find('ocs2_mobile_manipulator') + (
              (lambda v, major: (
                '/config/kuavo5/task.info' if major == 5 or (100 > v and v >= 50) else
                '/config/kuavo/task.info' if major == 4 or (100 > v and v >= 40) else
                '/config/roban2/task.info' if (major >= 1 and 3 >= major) or (100 > v and v >= 10) else
                '/config/kuavo/task.info'
              ))(arg('robot_version'), (arg('robot_version') // 10) % 10000)
            ))" />        <!-- The library folder to generate CppAD codegen into -->
      <arg name="libFolder"   value="$(find ocs2_mobile_manipulator)/auto_generated/kuavo" />
      
      <include file="$(find ocs2_mobile_manipulator_ros)/launch/include/mobile_manipulator.launch">
            <arg name="rviz"        value="$(arg rviz)" />
            <arg name="debug"       value="$(arg debug)" />
            <arg name="sqp_mpc"     value="$(arg sqp_mpc)" />
            <arg name="urdfFile"    value="$(arg urdfFile)" />
            <arg name="taskFile"    value="$(arg taskFile)" />
            <arg name="libFolder"   value="$(arg libFolder)" />
      </include>
</launch>