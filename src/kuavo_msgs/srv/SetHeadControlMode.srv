# 头部控制模式设置服务
# 请求部分
string mode          # vr_follow / fixed / track_hand，或直接写注视目标 both_hands_midpoint / left_hand / right_hand / active_hand
string fixed_hand    # mode 为 track_hand 时的注视目标: both_hands_midpoint / left_hand / right_hand / active_hand。留空保持当前目标。vr_follow 和 fixed 忽略该字段
---
# 响应部分
bool success         # 是否成功
string message       # 响应消息
string current_mode  # 当前模式
