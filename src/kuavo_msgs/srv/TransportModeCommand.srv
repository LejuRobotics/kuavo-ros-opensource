uint8 TRANSPORT_ENTER=1      # 进入搬运姿态（MPC 插值 → READY）
uint8 TRANSPORT_LOCK=2       # 锁定关节（READY → ACTIVE）
uint8 TRANSPORT_EXIT=3       # 最终出口：HANDING_OVER → INACTIVE
uint8 TRANSPORT_FALL_DOWN=4  # 掉使能倒地：ACTIVE → FALL_DOWN → HANDING_OVER
uint8 TRANSPORT_HAND_OVER=5  # 移交管理权：READY/ACTIVE → HANDING_OVER
uint8 command
---
bool success
string message
