<?xml version="1.0"?>
<package format="2">
  <name>leju_mobile_base_msgs</name>
  <version>1.0.0</version>
  <description>ROS message and service definitions for Leju Mobile Base robot platform</description>

  <maintainer email="developer@leju-mobile-base.com">Leju Mobile Base Team</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>map_msgs</build_depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>map_msgs</exec_depend>

  <export>
  </export>
</package>
