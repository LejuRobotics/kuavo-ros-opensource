# Lower-level controller version and parameter information

Header header

# Firmware version
string firmware_version

# Hardware version
string hardware_version

# Controller ID，控制调度变更(无则不填)
string controller_id 

# Serial number，底盘用户名
string serial_number

# Build date，编译日期
string build_date

# Configuration parameters as key-value pairs，扩展用，目前无
string[] param_names
string[] param_values
