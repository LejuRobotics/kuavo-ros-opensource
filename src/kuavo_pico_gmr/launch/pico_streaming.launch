<?xml version="1.0"?>
<!--
  PICO GMR Streaming Launch File

  This launch file starts the PICO motion retargeting system that:
  - Receives PICO body tracking data via UDP (pico_comm_minimal / pico_comm_vpn)
  - Performs real-time motion retargeting to Kuavo robot (pico_realtime_retarget node)
  - Publishes retargeted pose to /pico/retargeted_pose (picoPoseRetarget)
  - Publishes VMP input data to /vmp/input_data (Float32MultiArray)

  Prerequisites:
  1. Python 3.10 virtual environment with GMR dependencies installed
     - Run: cd $(rospack find kuavo_pico_gmr) && bash setup_venv.sh
     - Or set PICO_GMR_VENV_PATH environment variable

  2. PICO device on the same network as the robot (LAN mode)
     OR WireGuard VPN with server (VPN mode, vpn_mode:=true)

  Usage:
    # LAN mode (default)
    roslaunch kuavo_pico_gmr pico_streaming.launch

    # VPN mode (UDP TeleopCommand authorization)
    roslaunch kuavo_pico_gmr pico_streaming.launch vpn_mode:=true

    # Custom robot type and human height
    roslaunch kuavo_pico_gmr pico_streaming.launch robot:=kuavo_s52 human_height:=1.54
-->
<launch>
  <!-- Robot configuration -->
  <arg name="robot" default="kuavo_s52" doc="Target robot type (kuavo_s45, kuavo_s52)"/>

  <!-- PICO parameters -->
  <arg name="human_height" default="1.32" doc="Estimated human height in meters"/>

  <!-- PICO UDP diagnostics -->
  <arg name="diagnostic_allow_legacy" default="false" doc="Allow old bare VRData packets without fixed header"/>
  <arg name="diagnostic_log_enable" default="false" doc="Write PICO diagnostic JSONL logs"/>

  <!-- Operation mode (mutually exclusive) -->
  <arg name="vpn_mode" default="false" doc="Enable VPN session authorization mode (UDP TeleopCommand)"/>
  <arg name="vpn_server_url" default="http://10.77.0.1:9090" doc="VPN server URL for robot_status notify"/>
  <arg name="diagnostic_sync_max_valid_rtt_ms" default="$(eval 200.0 if arg('vpn_mode') else 20.0)" doc="Clock-sync sample RTT limit in ms; raise it for VPN/5G-A jitter"/>
  <arg name="diagnostic_sync_max_valid_residual_ms" default="$(eval 10.0 if arg('vpn_mode') else 5.0)" doc="Clock-sync model residual P95 limit in ms"/>

  <!-- Visualization -->
  <arg name="enable_viewer" default="false" doc="Enable MuJoCo viewer (may impact performance)"/>

  <!-- GMR smoothing parameters -->
  <arg name="enable_gmr_smoothing" default="true" doc="Enable Gaussian filter smoothing"/>
  <arg name="gmr_gaussian_sigma" default="1.0" doc="Gaussian kernel sigma (larger = smoother)"/>
  <arg name="gmr_velocity_clip" default="20.0" doc="Velocity clipping threshold"/>
  <arg name="gmr_velocity_deadzone" default="0.05" doc="Velocity deadzone (values below this are set to 0)"/>

  <!-- Dexterous hand control (subscribes /pico/joy, publishes /control_robot_hand_position) -->
  <arg name="enable_dexhand_control" default="true" doc="Enable dexterous hand control via PICO grip"/>

  <!-- Head control (subscribes /robot_body_matrices, publishes /robot_head_motion_data) -->
  <arg name="enable_head_control" default="true" doc="Enable head control node"/>
  <arg name="head_control_mode" default="auto_track_active" doc="Head control mode (fixed/auto_track_active/fixed_main_hand/vr_follow)"/>

  <!-- CPU affinity: bind retarget process to specific cores, e.g. [4] for P-core on Ultra 7 255H -->
  <arg name="cpu_cores" default="[]" doc="CPU cores to bind retarget process (empty=no binding)"/>

  <!-- compute LAN mode boolean -->
  <arg name="__is_lan" value="$(eval not arg('vpn_mode'))"/>

  <!-- ================================================================ -->
  <!-- Node 1: PICO data receiver — one of two modes, mutually exclusive -->
  <!-- ================================================================ -->

  <!-- LAN mode: broadcast discovery (default, no vpn) -->
  <node if="$(arg __is_lan)"
        pkg="kuavo_pico_gmr" type="pico_comm_minimal_wrapper.sh" name="pico_comm_minimal"
        output="screen" respawn="true" respawn_delay="5">
    <param name="diagnostic_allow_legacy" value="$(arg diagnostic_allow_legacy)"/>
    <param name="diagnostic_log_enable" value="$(arg diagnostic_log_enable)"/>
    <param name="diagnostic_sync_max_valid_rtt_ms" value="$(arg diagnostic_sync_max_valid_rtt_ms)"/>
    <param name="diagnostic_sync_max_valid_residual_ms" value="$(arg diagnostic_sync_max_valid_residual_ms)"/>
  </node>

  <!-- VPN mode: session authorization via UDP TeleopCommand -->
  <node if="$(arg vpn_mode)"
        pkg="kuavo_pico_gmr" type="pico_comm_vpn_wrapper.sh" name="pico_comm_vpn"
        output="screen" respawn="true" respawn_delay="5">
    <param name="vpn_server_url" value="$(arg vpn_server_url)"/>
    <param name="diagnostic_allow_legacy" value="$(arg diagnostic_allow_legacy)"/>
    <param name="diagnostic_log_enable" value="$(arg diagnostic_log_enable)"/>
    <param name="diagnostic_sync_max_valid_rtt_ms" value="$(arg diagnostic_sync_max_valid_rtt_ms)"/>
    <param name="diagnostic_sync_max_valid_residual_ms" value="$(arg diagnostic_sync_max_valid_residual_ms)"/>
  </node>


  <!-- ================================================================ -->
  <!-- Node 2: Motion retargeting (requires gmr_venv)                    -->
  <!-- ================================================================ -->
  <node pkg="kuavo_pico_gmr" type="run_with_venv.sh" name="pico_realtime_retarget"
        output="screen" respawn="true" respawn_delay="5"
        args="$(find kuavo_pico_gmr)/scripts/pico_realtime_to_robot.py --robot $(arg robot) --human-height $(arg human_height)">
    <param name="enable_viewer" value="$(arg enable_viewer)"/>
    <param name="enable_gmr_smoothing" value="$(arg enable_gmr_smoothing)"/>
    <param name="gmr_velocity_clip" value="$(arg gmr_velocity_clip)"/>
    <param name="gmr_velocity_deadzone" value="$(arg gmr_velocity_deadzone)"/>
    <rosparam param="cpu_cores" subst_value="true">$(arg cpu_cores)</rosparam>
  </node>

  <!-- Node 3: Dexterous hand control -->
  <node if="$(arg enable_dexhand_control)"
        pkg="kuavo_pico_gmr" type="pico_dexhand_control_node.py" name="pico_dexhand_control"
        output="screen" respawn="true" respawn_delay="3"/>

  <!-- Node 4: Head control -->
  <node if="$(arg enable_head_control)"
        pkg="humanoid_controllers" type="start_node.sh" name="pico_head_control_gmr"
        output="screen" respawn="true" respawn_delay="3"
        args="python3 $(find noitom_hi5_hand_udp_python)/../pico-body-tracking-server/scripts/pico_head_control_node.py _mode:=$(arg head_control_mode)"/>
</launch>
