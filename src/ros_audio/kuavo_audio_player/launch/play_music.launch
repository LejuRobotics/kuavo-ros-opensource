<launch>
    <!-- 全机型统一单节点音频架构 (audio_player.py):
         启动闸门在节点内部 init_node 之前执行 —— 无声卡或 /play_music 已被
         对机提供时进程退出, 由 respawn 周期重试 (热插拔/对机死亡自动接管)。 -->

    <!-- 设置音频文件路径参数 -->
    <param name="music_path" value="/home/lab/.config/lejuconfig/music" />

    <node pkg="kuavo_audio_player" type="audio_player.py" name="audio_player_node" output="screen" respawn="true" respawn_delay="10"/>
</launch>
