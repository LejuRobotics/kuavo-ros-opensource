<launch>
    <!-- 定义命令行参数 -->
    <arg name="send_srv" default="1"/> <!-- 1: 不需要手动打开手臂控制，0: 需要手动打开手臂控制 -->
    <arg name="version" default="4" />
    <arg name="ctrl_arm_idx" default="2" />
    <arg name="ik_type_idx" default="0" />
    <arg name="ip_address" default="" />
    <arg name="control_torso" default="0" /> <!-- 0: do NOT control, 1: control torso  -->
    <arg name="camera_publisher_name" default="/camera/color" />
    <arg name="hand_reference_mode" default="thumb_index"/> <!-- fingertips, middle_finger, thumb_index -->
    <arg name="robot_version" default="$(optenv ROBOT_VERSION 40)"/>
    <arg name="wheel_ik" default="$(eval int(arg('robot_version')) // 10 == 6)"/> <!-- 轮臂机器人（6x 系列）为 true -->

    <!-- motion_capture_ik -->
    <node pkg="motion_capture_ik" type="ik_ros_uni.py" name="ik_ros_uni" args=" --version $(arg version) --ctrl_arm_idx $(arg ctrl_arm_idx) --ik_type_idx $(arg ik_type_idx) --send_srv=$(arg send_srv) --control_torso=$(arg control_torso) --hand_reference_mode=$(arg hand_reference_mode)" output="screen">
    </node>

    <!-- 5W 轮臂平台 VR 辅助节点（humanoid_quest_control_with_arm = QuestControlFSM）：
         负责 X+A/X+B 手臂模式切换（/wheel_arm_change_arm_ctrl_mode）与拨杆底盘速度（/cmd_vel）。
         方式1（launch_quest3_ik.launch）已含该节点，此处补齐，修复方式2（视频回传）下
         X+A 无法复位手臂、X+B 无法固定手臂、拨杆底盘无反应（kuavodevlab#3716）。 -->
    <node pkg="humanoid_interface_ros" type="humanoid_quest_control_with_arm" name="humanoid_quest_control_with_arm" output="screen" if="$(arg wheel_ik)" launch-prefix="$(find humanoid_controllers)/scripts/start_node.sh"/>
    <param name="/wheel_ik" value="$(arg wheel_ik)" type="bool"/>
    <param name="/use_cpp_incremental_ik" value="false" type="bool"/>

    <!-- noitom_hi5_hand_udp_python -->
    <node pkg="noitom_hi5_hand_udp_python" type="monitor_quest3.py" args="$(arg ip_address)" name="monitor_quest3" output="screen">
    </node>
    <node pkg="noitom_hi5_hand_udp_python" type="webrtc_videostream.py" name="webrtc_videostream" args="$(arg camera_publisher_name) $(arg ip_address)" output="screen"/>
</launch>
