# 请求参数
float64 x
float64 y
float64 theta
float64 linear_velocity
float64 angular_velocity
float64 position_threshold
float64 angle_threshold
bool avoid_enabled
bool allow_rotation
int32 target_smt_id      # SMT目标ID（用于写入黑板TargetSMTID，-1表示不设置）
int32 target_smt_id_row  # SMT目标行号（用于写入黑板TargetSMTIDRow，-1表示不设置）
---
# 响应
bool success
string message
int32 error_code

