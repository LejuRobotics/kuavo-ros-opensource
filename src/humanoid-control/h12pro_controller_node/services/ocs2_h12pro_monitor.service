[Unit]
Description=H12PRO Remote Controller Service with Monitor
After=network.target

[Service]
Type=simple
ExecStop=/bin/kill -SIGINT $MAINPID
Environment=ROS_MASTER_URI=http://kuavo_master:11311
Environment=ROS_IP=kuavo_master
Environment=KUAVO_ROS_CONTROL_WS_PATH=/home/lab/lpf/kuavo-ros-control
Environment=ROBOT_VERSION=61
Environment=NODE_SCRIPT=/home/lab/lpf/kuavo-ros-control/src/humanoid-control/h12pro_controller_node/scripts/start_ocs2_h12pro_node.sh
Environment=ROS_HOSTNAME=kuavo_master
ExecStart=/home/lab/lpf/kuavo-ros-control/src/humanoid-control/h12pro_controller_node/scripts/monitor_ocs2_h12pro.sh
User=root

[Install]
WantedBy=multi-user.target