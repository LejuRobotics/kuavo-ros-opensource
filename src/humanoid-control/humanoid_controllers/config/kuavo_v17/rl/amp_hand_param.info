    kickAngularVelocity     1.0    ; 脉冲角速度绝对值 (rad/s)
    durationSteps           10     ; 脉冲持续推理步数
    restCmdThreshold        0.2    ; |上一帧 cmd_angz| 低于该值则判定静止转向
    triggerAngularVelocity  0.5    ; 触发中心绝对值 (rad/s)
    triggerTolerance        0.25   ; 触发区间 [0.25, 0.75]
    forwardThreshold        0.2    ; abs(cmd_x) 超过则取消
    lateralThreshold        0.2    ; abs(cmd_y) 超过则取消
}

