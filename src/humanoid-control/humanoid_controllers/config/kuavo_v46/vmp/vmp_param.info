; VMP特定配置
; ========== VMP工作模式选择 ==========                    ; VMP播放模式选择 
vmpPlaybackMode            online_teleoperation          ; offline_trajectory: 传统（使用vmpTaskDataFile完整轨迹）
                                                         ; online_teleoperation: 在线VR全身遥操作（使用固定长度缓存区）

use_interploate_from_mpc     true       ; 从MPC切换到VMP时使用插值过渡（避免切换瞬间跳动）

----------------------------------------------------------------------------------------------------------------------------------------------
; —— 离线轨迹播放（offline_trajectory模式使用）

; 静止帧配置 (用于VMP轨迹前后添加静止帧) (仅用于offline_trajectory模式，online_teleoperation模式不使用)
preStandingFrames       80      ; 轨迹前添加的静止帧数量
postStandingFrames      80      ; 轨迹后添加的静止帧数量
standingHeight          0.87     ; 静止帧高度值

; 插值配置 (用于静止帧与运动轨迹之间的平滑过渡) (仅用于offline_trajectory模式，online_teleoperation模式不使用)
preInterpolationFrames   20      ; 前置插值帧数 (从静止帧过渡到运动轨迹)
postInterpolationFrames  50      ; 后置插值帧数 (从运动轨迹过渡到静止帧)


； —— 单轨迹播放配置
vmpModelDir                vmp_models/                  ; VMP模型文件目录
vmpPolicyModelFile         Nov02_13-15-33_v3_nominal.onnx           ; VMP策略模型文件
vmpEncoderModelFile        policy_vae_64.onnx            ; VAE编码器模型文件
vmpEstimatorModelFile      estimator_Nov07_18-44-45.onnx   ; Estimator模型文件（根据enableEstimator是否启用用estimator，需要同步修改onlinePolicyModelFile）
vmpRefDataDir              vmp_ref_data/               ; 参考数据目录
vmpTaskDataFile            yc_126_spec_data.bin        ; 任务数据文件(默认轨迹yc_126_spec_data，帧数将从文件大小自动计算)
enableLoop                 true                ; 是否启用轨迹循环播放（false时按下VMP启动按钮会继续播放 （目前不稳定!!），true会自动循环播放）


; —— 多轨迹播放配置 （仅测试使用！）
multiTrajectoryMode        false                         ; 是否启用多轨迹模式（false:单轨迹循环, true:多轨迹播放）
trajectorySequence         task_data_yc_01.bin,task_data_yc_02.bin,task_data_yc_06.bin ; 轨迹序列（逗号分隔，帧数将从文件大小自动计算）
autoSwitchTrajectory       true                         ; 是否自动切换轨迹（完成一个后自动切换到下一个）
trajectoryLoopMode         true                         ;多轨迹序列是否循环播放（false时按下VMP启动按钮会继续播放（目前不稳定！！），true会自动循环播放）
enablePreloading           true                         ; 是否启用轨迹预加载（true:预加载所有轨迹, false:动态加载）


----------------------------------------------------------------------------------------------------------------------------------------------
; —— 在线VR全身遥操作配置（online_teleoperation模式使用）
; 当vmpPlaybackMode=online_teleoperation时，以下配置生效
onlineVRDataSource         pico                          ; 在线VR数据源选项：
                                                         ; - bin_file: 离线bin文件模拟（用于测试）
                                                         ; - pico: PICO VR设备数据源（订阅 /pico/retargeted_pose）
                                                         ; - mocap: 动捕系统数据源（订阅 /mocap/retargeted_pose）

onlineVRControlMode        upper_body                    ; 在线VR控制模式：
                                                         ; - full_body: 全身模式（更新所有数据：机身、腿部、手臂）
                                                         ; - upper_body: 上半身模式（仅更新手臂关节和手部末端位置，其他保持静止帧）


; 在线VR专用模型配置（可选，如果不配置则使用离线模式的模型）
onlinePolicyModelFile      policy_1_Dec08_13-00-56_cuda0_v1.onnx    ; 在线VR专用策略模型文件
onlineEncoderModelFile     new_64_30_baseline.onnx                      ; 在线VR专用VAE编码器模型文件
onlineEstimatorModelFile   estimator_3d_Dec08_13-00-56_cuda0_v1.onnx   ; 在线VR专用Estimator模型文件（根据enableEstimator是否启用用estimator，需要同步修改onlinePolicyModelFile）

onlineVRBinFile            yc_126_spec_data.bin   ; 用于模拟在线VR的bin文件（仅当onlineVRDataSource=bin_file时使用，帧数将从文件大小自动计算）
onlineBufferSize           60                          ; 在线缓存区大小（帧数，默认200帧=1秒@100Hz）
onlineUpdateRate           100.0                        ; 在线缓存区更新频率（Hz，默认100Hz）

; Qpos平滑配置（重复帧回溯插值，消除阶梯状重复数据）
enableQposSmoothing        true                          ; 是否启用Qpos平滑（true:启用重复帧插值, false:直接使用原始数据）
qposSmoothBufferSize       5                             ; 平滑缓冲区大小（帧数，即输出延迟tick数，推荐3-8）
qposNewJointEps            0.001                         ; 关节位置"新数据"判定阈值（rad，max(|q_new - q_old|) > eps 视为新数据）

; GMR数据平滑配置（高斯滤波，用于处理GMR重定向后的噪声数据）
enableGMRSmoothing         true                         ; 是否启用GMR数据平滑（true:启用高斯滤波, false:使用原始数据）
gmrGaussianSigma           1.0                           ; 高斯滤波sigma参数（越大越平滑，推荐1.0-3.0，与scipy.ndimage.gaussian_filter1d参数一致）
gmrVelocityClip            20.0                          ; 速度裁剪阈值（rad/s，超过此值的速度会被裁剪，防止异常值）
gmrVelocityDeadzone        0.05                          ; 速度死区阈值（rad/s，低于此值的速度会被置为0，防止静止时抖动）


---------------------------------------------------------------------------------------------------------------------------------------------
; 基础控制参数
; 关节顺序说明：
;   - 无腰部机型(v46): 腿(0-11) + 手臂(12-25) = 26个关节
;   注意：配置文件中的参数顺序应与上述硬件顺序一致

withArm            true        ; 是否使用手臂训练
jointNum           12          ; 腿部关节数量
jointArmNum        14          ; 手臂关节数量
waistNum           0           ; 腰部关节数量 (kuavo_v46=0, kuavo_v52=1)
inferenceFrequency 100         ; 推理频率


; ========== Estimator模块配置（可配置） ==========
enableEstimator         true                           ; 是否启用Estimator模块（false:关闭, true:启用）
estimatorHistoryFrames  8                              ; Estimator历史缓存区大小（帧数）
estimatorInputDim       83                              ; Estimator每帧输入维度（单帧观测维度）
estimatorOutputDim      64                              ; Estimator输出维度（状态估计编码）
                                                        ; 注意：ONNX输入为flatten后的1328维 (16*83)
                                                        ; 模型文件配置：
                                                        ; - 离线模式使用 vmpEstimatorModelFile
                                                        ; - 在线模式使用 onlineEstimatorModelFile（可选，不配置则使用离线模型）

enableThetaNormalization true  ; 是否启用theta yaw角归一化功能
actionScale        0.25    ; 动作缩放系数（恢复到0.25）
frameStack         1       ; 单帧观测(frame_stack = 1)
cFrameStack        3       ; 特权观测帧数(c_frame_stack = 3)
numSingleObs       83      ; 单一时刻的obs的维度
numRefMotionObs    77      ; 参考运动观测维度
numEncoderObs      64      ; 编码器观测维度
numActions         26      ; 动作维度(VMP策略输出26维)
numAux             66      ; 辅助观测维度
episodeLengthS     30      ; 回合长度(秒)
decimation         10      ; 控制频率分频(100Hz)
clipObservations   18.0    ; 观测裁剪值
clipActions        18.0    ; 动作裁剪值（恢复到18.0）

; 观测缩放参数 (对齐 VMPKuavoCfg.normalization.obs_scales)
obsScale_dof_pos               1.0     ; 关节位置缩放
obsScale_dof_vel               0.05    ; 关节速度缩放
obsScale_base_lin_vel          2.0     ; 基座线速度缩放
obsScale_base_ang_vel          1.0     ; 基座角速度缩放
obsScale_height_measurements   5.0     ; 高度测量缩放
obsScale_quat                  1.0     ; 四元数缩放


----------------------------------------------------------------------------------------------------------------------------------------------
; VAE模型配置
vaeModel
{
    in_c            77      ; 输入通道数
    window_r        15      ; 右窗口长度
    window_l        30      ; 窗口长度(2*window_r)
    base_c          128     ; 基础通道数
    latent_d        64      ; 潜在维度
    scalors         3       ; 缩放器数量[0.8,0.6,0.4]
    encode_atten    true    ; 是否使用注意力编码
    a               0.01    ; 参数a
    d               2       ; 参数d(1 <= d <= 3)
    beta            0.7     ; beta参数
    encode_method   TCN     ; 编码方法(TCN或classic)
    use_global_coef false   ; 是否使用全局均值/标准差归一化(v46暂无全局系数,使用局部归一化)
}

; 参考运动配置 (v46: 77维参考运动格式)
; 格式: h(1) + theta(6) + v(6) + q(26) + q_dot(26) + p(12) = 77
; p(12)末端位置顺序: L_hand(3) + R_hand(3) + L_foot(3) + R_foot(3) (先手后腿，先左后右)
refTask
{
    h_start_id      0       ; 高度开始ID
    h_end_id        1       ; 高度结束ID
    theta_start_id  1       ; 方向开始ID
    theta_end_id    7       ; 方向结束ID
    v_start_id      7       ; 速度开始ID
    v_end_id        13      ; 速度结束ID
    q_start_id      13      ; 关节位置开始ID (v46: 26关节)
    q_end_id        39      ; 关节位置结束ID (13+26=39)
    q_dot_start_id  39      ; 关节速度开始ID
    q_dot_end_id    65      ; 关节速度结束ID (39+26=65)
    p_start_id      65      ; 位置开始ID (末端位置12维: L_hand+R_hand+L_foot+R_foot)
    p_end_id        77      ; 位置结束ID (65+12=77)
    num_tracklink   4       ; 追踪链接数量
    track_link      zarm_l5_link,zarm_r5_link,leg_l6_link,leg_r6_link   ; 先手后腿，先左后右
}

