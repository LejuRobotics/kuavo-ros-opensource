    kx                  10.0       ; 笛卡尔平移刚度 (N/m)，越小越软（建议 5~20）
    dx                  3.5         ; 笛卡尔平移阻尼 (N·s/m)，随 kx 同步调（建议 2~6）
    eeFrame             0           ; 末端参考系：0=zarm_l7_end_effector（左），1=zarm_r7_end_effector（右）
    forceEstGain        100.0        ; 外力估计→导纳偏移增益（0=关闭外力跟随，仅纯阻抗）
}

