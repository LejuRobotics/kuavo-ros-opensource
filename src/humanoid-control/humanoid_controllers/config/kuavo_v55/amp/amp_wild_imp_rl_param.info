; ==================== 手臂关节空间阻抗控制配置（柔顺交互 Phase 1） ====================
; 通过 /change_arm_ctrl_mode 服务切换手臂到模式3（关节空间阻抗）后生效
armImpedance
{
    enabled             true        ; 是否启用关节空间阻抗（模式3）(true/false)
    ; 切进本控制器时自动进入的手臂模式：0=不自动（保持模式1 自动摆臂），3=关节阻抗，4=笛卡尔阻抗
    ; （默认=配置了阻抗时取 3；激活瞬间若手臂正在归位，ArmController 会拒绝，控制器会在 2s 内重试）
    enterOnActivate     3
    ; 阻抗刚度/阻尼（arm-sized：左臂 zarm_l1..l7 在前，右臂 zarm_r1..r7 在后，共14维）
    ; 固定关节阻抗：直接使用下列 kp/kd，不启用肩部可变阻抗与平滑回位。
    ; 当前调试值：第二关节 kp=20，第三关节 kp=12、kd=0.15。
    kp
    {
        (0,0)   18.0     ; zarm_l1
        (1,0)   25.0     ; zarm_l2：第二关节回位加强
        (2,0)   8.0      ; zarm_l3：固定阻抗回位
        (3,0)   4.0     ; zarm_l4
        (4,0)   7.0     ; zarm_l5
        (5,0)   7.0     ; zarm_l6
        (6,0)   7.0     ; zarm_l7
        (7,0)   18.0     ; zarm_r1
        (8,0)   25.0     ; zarm_r2：第二关节回位加强
        (9,0)   8.0      ; zarm_r3：固定阻抗回位
        (10,0)  4.0     ; zarm_r4
        (11,0)  7.0     ; zarm_r5
        (12,0)  7.0     ; zarm_r6
        (13,0)  7.0     ; zarm_r7
    }
    kd
    {
        (0,0)   0.90    ; zarm_l1
        (1,0)   0.90    ; zarm_l2
        (2,0)   0.15    ; zarm_l3
        (3,0)   0.20    ; zarm_l4
        (4,0)   0.35    ; zarm_l5
        (5,0)   0.35    ; zarm_l6
        (6,0)   0.35    ; zarm_l7
        (7,0)   0.90    ; zarm_r1
        (8,0)   0.90    ; zarm_r2
        (9,0)   0.15    ; zarm_r3
        (10,0)  0.20    ; zarm_r4
        (11,0)  0.35    ; zarm_r5
        (12,0)  0.35    ; zarm_r6
        (13,0)  0.35    ; zarm_r7
    }
    targetSource    0           ; 目标位姿来源：0=弹簧回默认位（交互后自动回位），1=保持进入时位姿
    maxJointVel     10.0         ; 关节速度上限 (rad/s)，超限自动回退锁定模式（安全保护）
    forceLimit      20.0        ; 关节力矩软限制 (N·m)，与 torqueLimits 取小值
    useCST          true        ; 使用 CST 力矩模式下发（true）；false 则用 CSP（会被 PDO 覆盖成高刚度，柔顺失效，不建议）
    switchGuardDeg  20.0
    handoverDuration 0.5        ; 退出阻抗时先平滑恢复位置/增益，再释放电机模式
    ; ---- 肘关节随肩部 pitch 负向随动（仅模式3；肘以 CSP(2) 位置模式跟随，不参与阻抗柔顺）----
    ;   肘目标 = 肘参考位 + k · min(0, 肩pitch位移)；肩 pitch 只有【负向】偏移时肘才跟，正向偏移肘不动。
    ;   位移量 = 肩pitch测量值 − 肩pitch参考位（参考位与阻抗目标一致：targetSource=0 时即默认位）。
    ;   关节约定：l1/r1 = 肩 pitch（绕Y），l4/r4 = 肘；ratio 即 k，0.5 表示 pitch 动 10° 肘跟 5°。
    elbowFollowEnabled      true
    elbowFollowRatio        1.5
    elbowFollowMaxOffsetDeg 50.0    ; 随动角度上限（度，相对参考位；<=0 不限制）
    ; obsInputEnabled 默认 true：真实手臂角度/速度进入模型，是拉手臂带动身体的输入链路。
    ; 若另行配置为 false，模式3/4会屏蔽手臂观测，手臂仍柔顺但模型无法感知其偏转。
    ; ---- 喂给 onnx 的手臂 pitch / 肘关节角度限幅（本控制器全模式生效）----
    ;   人/外部控制器可以把手臂带到训练分布之外的大角度，这里把【观测值】截断在 ±该值；
    ;   只截断角度（jointPos，即相对默认位的偏差），不改速度、不改实际下发的关节角度；
    ;   obsPitchClipDeg 管肩 pitch(l1/r1) 与腕 pitch(l6/r6)；obsElbowClipDeg 管肘(l4/r4)。
    ;   肘默认位≈0（伸直）且物理上只能向负走，所以 ±30° 实际就是把“肘弯曲量”限制在 30° 内。
    ;   两者 <=0 则关闭（肘 <=0 时沿用 obsPitchClipDeg）。
    ; 这是观测幅度上限，不是触发阈值或速度限幅；肩偏转30度仍只按15度喂模型。
    ; 跟随力度需结合实际肩/肘偏转、观测及身体速度标定，不能从该值直接换算m/s。
    obsPitchClipDeg     20.0
    ; 肘关节观测限幅（度）：单独可调；<=0 时沿用 obsPitchClipDeg
    obsElbowClipDeg     20.0
    ; 锁死手腕开关：true=模式3阻抗不控制手腕，手腕三关节（l5/l6/l7 与 r5/r6/r7）目标固定默认位，
    ; 并以 CSP(2)+motorPdo 高增益位置锁定（不参与柔顺）；false=手腕照常参与阻抗柔顺
    lockWristJoints  true
}

; ==================== 手臂笛卡尔空间阻抗控制配置（柔顺交互 Phase 2） ====================
; 通过 /change_arm_ctrl_mode 服务切换手臂到模式4（笛卡尔空间阻抗）后生效
; 柔顺度调节：kx 越小越软（回复力小）；dx 应与 kx 匹配（约 0.35*sqrt(kx)，防震荡）；
