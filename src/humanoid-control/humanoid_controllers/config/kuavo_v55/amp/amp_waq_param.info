; AMP_WAQ：S54 训练模型部署到 S55。
; 通用配置结构、注释与 motor_pdo_kp/kd 参考同目录 skw_rl_param_wild.info。
; 默认关节姿态、jointKp/jointKd、torqueLimits 保留该 WAQ 训练配置。
; PDO 增益属于固件单位，与训练物理 PD 不可直接等同；当前仅完成仿真验证。
; 关节顺序：左腿 6、右腿 6、腰 yaw 1、左臂 7、右臂 7。
; WAQ 输入为过去 9 帧 + 当前帧，每帧 91 维；ONNX 内含归一化与编码器。

; ==================== WAQ 专用参数 ====================
waqActivityCommand               1.0    ; 行走活动量 [0,1]，站立时输入 0；不同于旧 AMP 的站立标志
waistZeroTrackingEnabled          false    ; 关闭腰部目标替换，保持 WAQ 原始动作
use_stand_default_joint_state false    ; 站立也使用策略输出，不替换为默认姿态
enable_elbow_scale                false    ; 关闭旧 AMP 肘部动作缩放
enable_elbow_upper                false    ; 关闭旧 AMP 肘部动作偏置

; ==================== 模型与推理 ====================
withArm                      true        ; 是否使用手臂训练 0:不使用 1:使用
inferenceFrequency           100         ; 推理频率

actionScale                  0.25        ; default
frameStack                   10    ; WAQ 固定 10：9 帧历史 + 当前帧，复位时历史清零
numSingleObs                 91          ; 单一时刻的obs的维度
cycleTime                    1.2    ; 父类兼容项；WAQ 无相位观测，不使用周期输入
cycleTime_short              1.2    ; 父类兼容项；WAQ 不使用步频切换
switch_ratio                 1.2    ; 父类兼容项；WAQ 不使用步频切换
phase                        0    ; 父类兼容项；WAQ 不使用相位输入
episodeLength                0    ; 父类兼容项；WAQ 不使用相位输入
clipObservations             18    ; 父类兼容占位值；WAQ 不裁剪观测，仅检查数值有限
clipActions                  18    ; 父类兼容占位值；WAQ 不裁剪动作，执行层保留力矩限制
use_jointcmd_filter          true    ; 启用输出滤波，保留源分支的实际配置值
use_external_arm_controller  true    ; 沿用 AMP 手臂模式控制，在执行层按模式替换手臂指令
use_external_waist_controller false       ; 是否使用外部腰部控制器指令替代模型输出的腰部指令 0:不使用 1:使用
use_interploate_from_mpc     true        ; 从MPC切换到这个模型时是使用插值还是直接切换 0:不使用 1:使用
use_default_motor_csp_kpkd   false       ; ECmaster的电机是否使用默认的kpkd(kuavo.json),还是当前info中定义的，motor_pdo_kp、motor_pdo_kd
use_amp_ruiwo_kpkd           true        ; 是否在 AMP 控制器中使用并切换 AMP 专用 Ruiwo 手臂增益(true/false)

networkModelFile             /ampwaqjzx261029_2.onnx    ; WAQ 导出模型，输入 [1,910]，输出 [1,27]
; ==================== 指令初始化与缩放（WAQ 保持训练比例 1） ====================
commandData
{
    inital
    {
        cmdVelLineX                  0
        cmdVelLineY                  0
        cmdVelLineZ                  0
        cmdVelAngularX               0
        cmdVelAngularY               0
        cmdVelAngularZ               0
        cmdStance                    1
    }
    scale
    {
        cmdVelLineX                  1           ; 输入模型的最大 cmdVelLineX = scale[0] * velocityLimits[0]
        cmdVelLineY                  1           ; 输入模型的最大 cmdVelLineY = scale[1] * velocityLimits[1]
        cmdVelLineZ                  1           ; 输入模型的最大 cmdVelLineZ = scale[2] * velocityLimits[2]
        cmdVelAngularX               1
        cmdVelAngularY               1
        cmdVelAngularZ               1           ; 输入模型的最大 cmdVelAngularZ = scale[5] * velocityLimits[3]
        cmdStance                    1
        cmdVelLineXNegScale          1           ; X 负向单独缩放系数（用于实现不对称速度限制：neg_limit = limit * this_scale）
    }
}

; ==================== 速度上限 ====================
velocityLimits
{
    (0,0)                        1.         ; cmdVelLineX limit (positive)
    (1,0)                        0.3         ; cmdVelLineY limit (positive and negative)
    (2,0)                        0.3         ; cmdVelLineZ limit (positive and negative)
    (3,0)                        0.5         ; cmdVelAngularZ limit (positive and negative)
}
defaultBaseHeightControl     0.97        ; Actual standing height when using RL controller
defaultBaseXOffsetControl    -0.0        ; Base offset when using RL controller

; 不定义全局 autoControllerSwitch，避免覆盖原有 S55 AMP 自动切换配置。


; ==================== 原地踏步指令（WAQ 不添加起步偏置） ====================
inPlaceStepVelocity
{
    linearX                      0           ; 原地踏步线速度X
    linearY                      0           ; 原地踏步线速度Y
    linearZ                      0           ; 接口留用
    angularX                     0           ; 接口留用
    angularY                     0           ; 接口留用
    angularZ                     0           ; 原地踏步角速度Z
}

continuousInPlaceStepVelocity
{
    linearX                      0           ; 持续原地踏步线速度X
    linearY                      0           ; 持续原地踏步线速度Y
    linearZ                      0           ; 接口留用
    angularX                     0           ; 接口留用
    angularY                     0           ; 接口留用
    angularZ                     0           ; 持续原地踏步角速度Z
}

; ==================== 指令补偿（WAQ 关闭） ====================
yawCompensation
{
    enabled                      false       ; 是否启用YAW补偿(true/false)
    xBias                        0           ; 通用X轴偏置
    threshold                    0.0         ; YAW阈值
    xVelocityThreshold           0.1         ; X方向速度阈值
    enableSeparateCompensation   false       ; 是否启用分开补偿（顺时针/逆时针）(true/false)
    xBiasClockwise               0           ; 顺时针旋转时X轴偏置
    xBiasCounterclockwise        0           ; 逆时针旋转时X轴偏置
}

yDirectionCompensation
{
    enabled                      false       ; 是否启用Y方向行走补偿(true/false)
    xBias                        0           ; 通用X轴偏置
    zBias                        0           ; 通用Z轴角速度偏置
    threshold                    0.0         ; Y方向速度阈值
    enableSeparateCompensation   false       ; 是否启用分开补偿（左/右）(true/false)
    xBiasLeft                    0           ; 向右行走时X轴偏置(从后往前看)
    xBiasRight                   0           ; 向左行走时X轴偏置(从后往前看)
    zBiasLeft                    0           ; 向右行走时Z轴角速度偏置(从后往前看)
    zBiasRight                   0           ; 向左行走时Z轴角速度偏置(从后往前看) 往左旋转是正
}

; ==================== 混合运动限制（WAQ 关闭） ====================
mixedMotionLimits
{
    enableMixedMode              false       ; 是否启用混合运动模式(true/false)
    angularVelThreshold          0.25        ; 角速度阈值 (rad/s)
    maxLinearVelWithAngular      0.2         ; 有角速度时最大线速度 (m/s)
    linearVelThreshold           0.4         ; 线速度阈值 (m/s)
    maxAngularVelWithLinear      0.4         ; 有线速度时最大角速度 (rad/s)
    smoothTransition             false       ; 是否启用平滑过渡(true/false)
    transitionFactor             0.9         ; 过渡因子
}

stanceToWalkHipRollBias      0.0         ; 初始偏置值（弧度）
stanceToWalkBiasDuration     0.0         ; 偏置衰减时间（秒）

; ==================== 父类外部手臂 / 腰部参数（手臂开启，腰部关闭） ====================
armVelocityLimit
{
    maxTrackingVelocity          2.5         ; 手臂跟踪的最大速度 (rad/s)
    trackingErrorThreshold       0.1         ; 手臂跟踪误差阈值 (rad)，小于此值后完全接管
    modeInterpolationVelocity    1.0         ; 手臂插值的速度
}

waistControllerParam
{
    mode2CutoffFreq              0.8         ; 截止频率
    kp                           10          ; PD控制位置增益
    kd                           5           ; PD控制速度增益
}

