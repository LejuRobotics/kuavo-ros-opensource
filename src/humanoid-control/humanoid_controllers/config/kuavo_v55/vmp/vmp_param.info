refTask
{
    h_start_id      0       ; 高度开始ID
    h_end_id        1       ; 高度结束ID
    theta_start_id  1       ; 方向开始ID
    theta_end_id    7       ; 方向结束ID
    v_start_id      7       ; 速度开始ID
    v_end_id        13      ; 速度结束ID
    q_start_id      13      ; 关节位置开始ID (v52: 27关节)
    q_end_id        40      ; 关节位置结束ID (13+27=40)
    q_dot_start_id  40      ; 关节速度开始ID
    q_dot_end_id    67      ; 关节速度结束ID (40+27=67)
    p_start_id      67      ; 位置开始ID (末端位置12维: L_foot+R_foot+L_hand+R_hand)
    p_end_id        79      ; 位置结束ID (67+12=79)
}

