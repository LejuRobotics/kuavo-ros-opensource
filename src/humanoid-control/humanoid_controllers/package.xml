<?xml version="1.0"?>
<package format="2">
    <name>humanoid_controllers</name>
    <version>0.0.0</version>
    <description>The humanoid_controllers packages.</description>
    <maintainer email="liaoqiayuan@gmail.com">Qiayuan Liao</maintainer>
    <license>BSD</license>
    <author email="liaoqiayuan@gmail.com">Qiayuan Liao</author>

    <buildtool_depend>catkin</buildtool_depend>
    <build_depend>nodelet</build_depend>

    <build_depend>cmake_clang_tools</build_depend>
    <depend>roscpp</depend>
    <depend>rospy</depend>
    <depend>std_srvs</depend>
    <depend>std_msgs</depend>
    <depend>leju_utils</depend>
    <depend>kuavo_common</depend>
    <depend>kuavo_solver</depend>
    <depend>humanoid_common</depend>
    <depend>humanoid_interface</depend>
    <depend>humanoid_estimation</depend>
    <depend>humanoid_interface_ros</depend>
    <depend>humanoid_wheel_interface</depend>
    <depend>humanoid_wheel_interface_ros</depend>
    <depend>humanoid_interface_drake</depend>
    <depend>kuavo_estimation</depend>
    <depend>kuavo_monitor</depend>
    <depend>kuavo_msgs</depend>
    <depend>leju_mobile_base_msgs</depend>
    <!-- <depend>mujoco_sim</depend> -->
    <depend>mujoco_cpp</depend>
    <!-- EKF nodelet optional at build on aarch64 — stubs in robot_localization/CMakeLists.txt -->
    <depend>robot_localization</depend>
    <depend>humanoid_wbc</depend>
    <depend>humanoid_wheel_wbc</depend>
    <depend>controller_interface</depend>
    <depend>h12pro_controller_node</depend>
    <depend>joy</depend>
    <!-- motion_capture_ik: launch-time only (with_ik); catkin build still compiles it via exec_depend -->
    <exec_depend>motion_capture_ik</exec_depend>
    <!-- hardware_node: real-robot only -->
    <exec_depend>hardware_node</exec_depend>
    <depend>kuavo_assets</depend>
    <depend>ocs2_self_collision_visualization</depend>
    <depend>kuavo_audio_player</depend>
    <!-- real-robot / isaac launch only -->
    <!-- <exec_depend>mobile_manipulator_controllers</exec_depend> -->
    <!-- <depend>gazebo_sim</depend> -->
    <!-- <depend>realsense_ros_gazebo</depend> -->
    <depend>realsense_sim_metadata</depend>
    <depend>kuavo_audio_receiver</depend>
    <depend>kuavo_sdk</depend>
    <!-- <depend>ocs2_biped_robot_ros</depend> -->
    <depend>humanoid_plan_arm_trajectory</depend>
    <depend>angles</depend>
    <depend>kuavo_led_controller</depend>
    <exec_depend>nodelet</exec_depend>
    <exec_depend>controller_manager</exec_depend>
    <exec_depend>kuavo_mocap_gmr</exec_depend>
    <!-- launch-time only (with_pico_gmr); catkin build still compiles it via exec_depend -->
    <exec_depend>kuavo_pico_gmr</exec_depend>

    <export>
        <controller_interface plugin="${prefix}/humanoid_controllers_plugins.xml"/>
        <nodelet plugin="${prefix}/plugins/nodelet_controller_plugin.xml" />
        <nodelet plugin="${prefix}/plugins/nodelet_player_plugin.xml" />
    </export>
</package>
