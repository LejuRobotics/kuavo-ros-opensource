<?xml version="1.0" ?>
<launch>
    <arg name="real" default="true" />
    <arg name="log" default="true" />
    <arg name="cali" default="false" />
    <arg name="cali_arm" default="false" />
    <arg name="cali_leg" default="false" />

    <!-- -->
    <arg name="teach_pendant" default="0"/>
    <arg name="sg100_kp" default="10.0"/>
    <arg name="sg100_ki" default="0.0"/>
    <arg name="sg100_kd" default="0.02"/>
    <arg name="sg100_output_limit" default="0.5"/>

  <include file="$(find humanoid_controllers)/launch/load_kuavo_real.launch">
    <arg name="only_half_up_body" value="true"/>
    <arg name="real" value="$(arg real)" />
    <arg name="log" value="$(arg log)" />
    <arg name="cali" value="$(arg cali)" />
    <arg name="cali_arm" value="$(arg cali_arm)" />
    <arg name="cali_leg" value="$(arg cali_leg)" />
    <arg name="teach_pendant" value="$(arg teach_pendant)"/>
    <arg name="sg100_kp" value="$(arg sg100_kp)"/>
    <arg name="sg100_ki" value="$(arg sg100_ki)"/>
    <arg name="sg100_kd" value="$(arg sg100_kd)"/>
    <arg name="sg100_output_limit" value="$(arg sg100_output_limit)"/>
  </include>


</launch>   