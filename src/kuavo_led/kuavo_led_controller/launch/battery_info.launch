<launch>
    <arg name="BATTERY" default="enable" />
    <arg name="backend" default="serial" doc="serial=直接打开串口; ros_service=通过 LED 节点的 _query_battery_hw 服务获取数据"/>

    <!-- 当 BATTERY 不为 disable 时启动电池信息节点 -->
    <group unless="$(eval arg('BATTERY') == 'disable')">
        <!-- 启动电池信息节点 -->
        <node pkg="kuavo_led_controller" type="battery_info_node.py" name="battery_info_node" output="screen">
            <param name="backend" value="$(arg backend)" />
            <!-- 串口设备路径 (与LED共用) -->
            <param name="port" value="/dev/ttyLED0" />
            <!-- 波特率 -->
            <param name="baudrate" value="115200" />
            <!-- 发布频率 (Hz)。单轮含3次串口收发(0x01+0x03+0x04)，
                 每次约0.05s应答等待+读取，单轮约0.2s，上限约5Hz。
                 设3Hz响应较快且留余量，避免与LED串口锁冲突。 -->
            <param name="publish_rate" value="3.0" />
        </node>
    </group>

</launch>
