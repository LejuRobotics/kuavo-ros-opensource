<?xml version='1.0' encoding='utf-8'?>
<robot name="biped_s52">
  <mujoco>
    <compiler meshdir="../meshes/" balanceinertia="true" discardvisual="false" />
  </mujoco>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.05051209 1.42e-06 -0.01248997" rpy="0 0 0" />
      <mass value="6.48663928" />
      <inertia ixx="0.06836878" ixy="1.858e-05" ixz="-0.0165872" iyy="0.04966552" iyz="-1.2e-05" izz="0.06645264" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>
  <link name="waist_yaw_link">
    <inertial>
      <origin xyz="0.00089444 -0.00069446 0.16778314" rpy="0 0 0" />
      <mass value="18.01415568" />
      <inertia ixx="0.36258863" ixy="1.968e-05" ixz="0.00273234" iyy="0.27799251" iyz="0.00088683" izz="0.21591828" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../meshes/waist_yaw.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>
  <joint name="waist_yaw_joint" type="fixed">
    <origin xyz="0 0 0.1114" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="waist_yaw_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="180.0" velocity="23.55" />
  </joint>
  <!-- 固定参考坐标系：与 zarm_l1_joint 在同一位置，但不随关节转动 -->
  <link name="zarm_l1_ref_link">
    <visual>
      <!-- 不需要几何，只作为一个纯参考坐标系使用 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
      <material name="zarm_l1_ref_material">
        <color rgba="0 1 0 0" />
      </material>
    </visual>
  </link>
  <joint name="zarm_l1_ref_joint" type="fixed">
    <!-- 位置与 zarm_l1_joint 的 origin 完全一致 -->
    <origin xyz="-0.003 0.1737 0.2831" rpy="0 0 0" />
    <parent link="waist_yaw_link" />
    <child link="zarm_l1_ref_link" />
  </joint>
  <link name="zarm_l1_link">
    <inertial>
      <origin xyz="0.00166796 0.07275896 0.00012987" rpy="0 0 0" />
      <mass value="0.91653322" />
      <inertia ixx="0.00126587" ixy="1.362e-05" ixz="-2e-05" iyy="0.00086921" iyz="1e-05" izz="0.00124337" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../meshes/l_arm_pitch.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>
  <joint name="zarm_l1_joint" type="revolute">
    <!-- 现在相对于 zarm_l1_ref_link，不再需要平移 -->
    <origin xyz="0 0 0" rpy="0 0 0" />
    <!-- 改为从参考坐标系出发，这样 joint1 的link就挂在固定在腰上的参考frame下 -->
    <parent link="zarm_l1_ref_link" />
    <child link="zarm_l1_link" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159265358979" upper="1.5707963267949" effort="100.0" velocity="41.3433333333333" />
    <dynamics damping="0.2" friction="0.0" />
  </joint>
  <link name="zarm_l2_link">
