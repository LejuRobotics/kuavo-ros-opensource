  </link>
  <joint name="camera_base" type="fixed">
    <origin xyz="0.119717018973535 0.0237514612535074 0.0262044145991832" rpy="0 0.480224871300295 0" />
    <parent link="zhead_2_link" />
    <child link="camera_base" />
  </joint>

  <!-- 光学坐标系：采用标准光学坐标 (z 前, x 右, y 下)，以 camera_base 为父节点 -->
  <link name="camera_optical">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
      <material name="camera_optical_material">
        <color rgba="0 1 0 0" />
      </material>
    </visual>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <!-- 经典光学坐标变换：R = Rz(-90°) * Rx(-90°) -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
    <parent link="camera_base" />
    <child link="camera_optical" />
  </joint>

  <!-- 棋盘 link/joint：使用上一次 Step1 标定得到的 base_link -> checkerboard 位姿 -->
